; Africa Multiple — DRE theme
; Keeps indentation consistent across the mixed PHP / Sass / JS tree. Before
; this file, navigation.js and back-to-top.js used tabs while the other ten
; scripts used four spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{scss,css}]
indent_size = 4

[*.{js,mjs,json}]
indent_size = 4

[*.md]
; Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.ini]
indent_style = space
indent_size = 4

[view/layout/layout.phtml]
; The layout is historically tab-indented; left as-is to keep its diff readable.
indent_style = tab
