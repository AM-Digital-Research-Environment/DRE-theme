{
  "name": "dre-theme",
  "version": "2.35.0",
  "description": "Africa Multiple — Digital Research Environment. An Omeka S theme for the Africa Multiple Cluster of Excellence (University of Bayreuth), built on a modern OKLCH design-token system with light/dark modes.",
  "scripts": {
    "start": "npm run watch",
    "build": "npm run lint:source && npm run build:css && npm run lint:css",
    "build:css": "node scripts/build-css.mjs",
    "watch": "node scripts/build-css.mjs --watch",
    "verify": "npm run build && npm run i18n:check && npm run test:unit && npm audit --audit-level=high && node scripts/check-stale-css.mjs",
    "lint": "npm run lint:source && npm run lint:css",
    "lint:source": "npm run lint:tokens && npm run lint:touch && npm run lint:ini && npm run lint:templates && npm run lint:groups && npm run lint:js && npm run lint:php",
    "lint:tokens": "node scripts/gen-token-fallbacks.mjs --check && node scripts/check-design-tokens.mjs",
    "lint:touch": "node scripts/check-touch-targets.mjs",
    "lint:css": "node scripts/check-compiled-css.mjs",
    "lint:ini": "node scripts/check-theme-ini.mjs",
    "lint:templates": "node scripts/check-templates.mjs",
    "lint:groups": "node scripts/check-resource-groups.mjs",
    "lint:js": "eslint .",
    "lint:php": "node scripts/check-php.mjs",
    "lint:php:require": "node scripts/check-php.mjs --require",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/js/*.test.mjs",
    "test:live": "playwright test",
    "test:browser": "playwright test --config=playwright.local.config.mjs",
    "test:visual:experiment": "playwright test --config=playwright.visual.config.mjs",
    "audit:roadmap": "node scripts/audit-roadmap.mjs",
    "audit:surfaces": "node scripts/audit-live-surfaces.mjs",
    "fixtures:refresh": "node scripts/fetch-template-fixture.mjs",
    "i18n:extract": "node scripts/extract-translations.mjs",
    "i18n:check": "node scripts/extract-translations.mjs --check",
    "build:icons": "node scripts/gen-pwa-icons.mjs",
    "build:tokens": "node scripts/gen-token-fallbacks.mjs",
    "vendor:lint": "node scripts/vendor-lint.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AM-Digital-Research-Environment/DRE-theme.git"
  },
  "keywords": [
    "omeka-s",
    "theme",
    "africa-multiple",
    "digital-humanities"
  ],
  "author": "Frédérick Madore",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/AM-Digital-Research-Environment/DRE-theme/issues"
  },
  "homepage": "https://github.com/AM-Digital-Research-Environment/DRE-theme#readme",
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.29",
    "sass": "^1.105.1",
    "sharp": "^0.35.5"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "safari >= 16.2",
    "ios >= 16.2",
    "not op_mini all",
    "not kaios > 0",
    "not and_uc > 0",
    "not and_qq > 0"
  ]
}
