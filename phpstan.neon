# Static analysis of the theme's view helpers against the real Omeka S classes.
#
# Run by the "Omeka S release + PHP 8.5" CI job, which unpacks the official
# Omeka S release and points OMEKA_PATH at it; its Composer autoloader resolves
# Omeka\ and Laminas\ the way production does. Locally:
#
#   OMEKA_PATH=/path/to/omeka-s phpstan analyse
#
# Templates (.phtml) are not analysed: they are rendered by PhpRenderer, and
# tests/*Test.php plus tests/LayoutTest.php render them instead.
parameters:
    level: 6
    # Parameter and return types are PHPDoc, not native declarations: a wrong
    # native type is a TypeError, a 500 on every page. PHPDoc is not enforced
    # at runtime, and Omeka's own is not always right (resourceClass() can
    # return null), so the helpers' defensive null and method_exists() guards
    # are not reported as always true.
    treatPhpDocTypesAsCertain: false
    # Omeka 4.2.1's floor through production's runtime (8.5.10).
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - helper
    bootstrapFiles:
        # OMEKA_PATH and Omeka's Composer autoloader, as Omeka's bootstrap.php
        # provides them at runtime.
        - tests/phpstan-bootstrap.php
    ignoreErrors:
        # View helpers are reached through PhpRenderer's plugin broker (__call),
        # which AbstractHelper::getView() types as the bare RendererInterface.
        -
            message: '#^Call to an undefined method Laminas\\View\\Renderer\\RendererInterface::[A-Za-z]+\(\)\.$#'
            identifier: method.notFound
