<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->inlineScript()->appendFile($this->assetUrl('js/masonry.pkgd.min.js'));
$this->inlineScript()->appendFile($this->assetUrl('js/browse.js'));
$this->inlineScript()->appendFile($this->assetUrl('js/reveal.js'));
$this->htmlElement('body')->appendAttribute('class', 'item resource browse');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$query = $this->params()->fromQuery();
$itemSetShow = isset($itemSet);
if ($itemSetShow) {
    $this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));

    // Regions
    $mainBlockContent = $this->resourcePageBlocks($itemSet);
    $mainHasBlocks = $mainBlockContent->hasBlocks();
    $leftSidebarBlockContent = $this->resourcePageBlocks($itemSet, 'left');
    $leftSidebarHasBlocks = $leftSidebarBlockContent->hasBlocks();
    $rightSidebarBlockContent = $this->resourcePageBlocks($itemSet, 'right');
    $rightSidebarHasBlocks = $rightSidebarBlockContent->hasBlocks();

    $this->htmlElement('body')->appendAttribute('class', 'item-set');
    $query['item_set_id'] = $itemSet->id();
}

// Layout state (grid vs list, the ?view= override, body term and truncation)
// comes from the BrowseLayout view helper — see helper/BrowseLayout.php.
$layout = $this->BrowseLayout();
$isGrid = $layout['isGrid'];

$headingTerm = $this->siteSetting('browse_heading_property_term');
$bodyTerm = $layout['bodyTerm'];
$bodyTruncate = $layout['truncate'];

?>

<?php if ($itemSetShow): ?>
    <?php echo $this->ResourceTags($itemSet); ?>
    <?php echo $this->pageTitle($itemSet->displayTitle(null, ($valueLang)), 1); ?>

    <?php if ($mainHasBlocks || $leftSidebarHasBlocks || $rightSidebarHasBlocks): ?>

        <?php
        $additionalContainerClasses = '';
        if ($mainHasBlocks && $leftSidebarHasBlocks && $rightSidebarHasBlocks) {
            $additionalContainerClasses = 'regions-container--all';
        }
        ?>

        <div class="regions-container <?php echo $additionalContainerClasses; ?>">
            <?php if ($leftSidebarHasBlocks && $blockContent = $leftSidebarBlockContent->getBlocks()): ?>
                <div class="sidebar-region sidebar-region--left">
                    <div class="metadata">
                        <?php echo $blockContent; ?>
                    </div>
                </div>
            <?php endif; ?>

            <?php if ($mainHasBlocks && $blockContent = $mainBlockContent->getBlocks()): ?>
                <div class="main-region">
                    <div class="metadata">
                        <?php echo $blockContent; ?>
                    </div>
                </div>
            <?php endif; ?>

            <?php if ($rightSidebarHasBlocks && $blockContent = $rightSidebarBlockContent->getBlocks()): ?>
                <div class="sidebar-region sidebar-region--right">
                    <div class="metadata">
                        <?php echo $blockContent; ?>
                    </div>
                </div>
            <?php endif; ?>
        </div>

    <?php endif; ?>

    <div class="item-set-items">
    <?php echo '<h2>' . $escape($translate('Items')) . '</h2>'; ?>
<?php else: ?>
    <?php echo $this->pageTitle($translate('Items'), 1); ?>
<?php endif; ?>

<?php echo $this->searchFilters(); ?>

<?php echo $this->pagination(); ?>

<div class="browse-controls">
    <?php echo $this->partial('common/browse-layout-toggle', ['layout' => $layout]); ?>
    <?php echo $this->browse()->renderSortSelector('items'); ?>
    <div class="collection-search-container">
        <?php echo $this->hyperlink($translate('Search the collection'), $this->DreSearchUrl(), ['class' => 'collection-search']); ?>
    </div>
</div>

<?php $this->trigger('view.browse.before'); ?>

<?php if (!count($items)): ?>
    <?php
    // Empty state — the single-resource-type core search redirects here, so
    // this is where a fruitless sitewide search actually lands. A quiet pause
    // with a path onward; the active-filter chips above already restate the
    // query, so don't repeat it.
    $fulltext = trim((string) ($query['fulltext_search'] ?? ''));
    ?>
    <div class="search-empty">
        <?php if ($fulltext !== ''): ?>
            <p class="search-empty__lead"><?php echo $translate('Nothing in the collections matched this search.'); ?></p>
            <ul class="search-empty__hints">
                <li><?php echo $translate('Check the spelling, or try another form of the word.'); ?></li>
                <li><?php echo $translate('Fewer, broader terms cast a wider net.'); ?></li>
                <li><?php echo $translate('Names may appear transliterated — try a variant spelling.'); ?></li>
            </ul>
        <?php else: ?>
            <p class="search-empty__lead"><?php echo $translate('No items match the current filters.'); ?></p>
        <?php endif; ?>
        <div class="search-empty__actions">
            <a class="button" href="<?php echo $this->escapeHtmlAttr($this->DreSearchUrl()); ?>"><?php echo $escape($translate('Search with filters')); ?></a>
            <a class="button btn--secondary" href="<?php echo $this->escapeHtmlAttr($this->url(
                'site/resource',
                ['controller' => 'item', 'action' => 'browse'],
                [],
                true
            )); ?>"><?php echo $translate('Browse all items'); ?></a>
        </div>
    </div>
<?php else: ?>

<div class="resources <?php echo ($isGrid) ? 'resource-grid' : 'resource-list'; ?>">
    <div class="grid-sizer"></div>
    <div class="gutter-sizer"></div>
    <?php
    $revealIndex = 0;
    foreach ($items as $item):
        $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]')]) : $item->displayTitle(null, $valueLang);
        $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => ($valueLang)]) : $item->displayDescription(null, ($valueLang));
        $media = $item->primaryMedia();
        $altText = $media ? ($media->altText() ?: $item->displayTitle()) : $item->displayTitle();
        // The first row of cards rises in on entry — the DRE's shared reveal
        // grammar (F11, asset/js/reveal.js + utilities/_reveal.scss), a gentle
        // stagger echoing the home hero's arrival. Only the first few are tagged
        // so a long list doesn't animate end to end.
        echo $this->partial('common/resource-card', [
            'resource' => $item,
            'heading' => $heading,
            'body' => $body,
            'bodyTruncate' => $bodyTruncate,
            'thumbnail' => $this->thumbnail($item, 'large', ['alt' => $altText]),
            'isGrid' => $isGrid,
            'reveal' => $revealIndex < 6 ? $revealIndex * 70 : null,
        ]);
        $revealIndex++;
    endforeach; ?>

</div>

<?php endif; ?>

<?php echo ($itemSetShow) ? '</div>' : ''; ?>
<?php $this->trigger('view.browse.after'); ?>

<?php echo $this->pagination(); ?>
