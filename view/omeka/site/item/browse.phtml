<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->inlineScript()->appendFile($this->assetUrl('js/dist/browse.min.js'));
$this->inlineScript()->appendFile($this->assetUrl('js/dist/reveal.min.js'));
$this->htmlElement('body')->appendAttribute('class', 'item resource browse');

$valueLang = $this->ValueReader()->valueLang();

$query = $this->params()->fromQuery();
$itemSetShow = isset($itemSet);
if ($itemSetShow) {
    $this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));

    $this->htmlElement('body')->appendAttribute('class', 'item-set');
    $query['item_set_id'] = $itemSet->id();

    // A project's item set holds exactly the records that link to the project,
    // whose page is the one to read (DRE SEO redirects here to it; without
    // that, this page says so and searches the project's records).
    $collections = $this->ProjectCollections();
    $project = $collections->projectOf($itemSet);
    $projectRecordsUrl = $project ? $collections->recordsUrl($project) : '';
}

// Layout state (grid vs list, the ?view= override, body term and truncation)
// comes from the BrowseLayout view helper — see helper/BrowseLayout.php.
$layout = $this->BrowseLayout();
$isGrid = $layout['isGrid'];

$bodyTerm = $layout['bodyTerm'];
$bodyTruncate = $layout['truncate'];

?>

<?php if ($itemSetShow): ?>
    <?php echo $this->partial('common/breadcrumb', ['resource' => $itemSet]); ?>
    <?php echo $this->ResourceTags($itemSet); ?>
    <?php echo $this->pageTitle($itemSet->displayTitle(null, ($valueLang)), 1); ?>

    <?php if ($project): ?>
        <div class="record-notice" role="note">
            <p>
                <strong class="record-notice__lead"><?php echo $escape($translate('A project’s collection.')); ?></strong>
                <?php echo $this->TranslateFormat()->html()->translate(
                    'These records come from %s. The project’s page presents them with its description, its team and their visualisations.',
                    '<a href="' . $this->escapeHtmlAttr($project->url()) . '">' . $escape($project->displayTitle()) . '</a>'
                ); ?>
            </p>
        </div>
    <?php endif; ?>

    <?php echo $this->partial('common/resource-regions', ['resource' => $itemSet]); ?>

    <?php // The set's permanent URI and RDF documents, when DRE Linked Data is installed. ?>
    <?php echo $this->partial('common/record-linked-data', ['resource' => $itemSet]); ?>

    <div class="item-set-items">
    <?php echo '<h2>' . $escape($translate('Items')) . '</h2>'; ?>
<?php else: ?>
    <?php echo $this->pageTitle($translate('Items'), 1); ?>
<?php endif; ?>

<?php echo $this->searchFilters(); ?>

<?php echo $this->pagination('common/pagination-top'); ?>

<div class="browse-controls">
    <?php echo $this->partial('common/browse-layout-toggle', ['layout' => $layout]); ?>
    <?php // The visitor's sorts (BrowseSort), not every numeric column; core's form if
          // the curated one cannot be built. ?>
    <?php echo $this->plugin('BrowseSort')->selector('items'); ?>
    <div class="collection-search-container">
        <?php if ($itemSetShow && $projectRecordsUrl !== ''): ?>
            <?php echo $this->hyperlink($translate('Search these records'), $projectRecordsUrl, ['class' => 'collection-search']); ?>
        <?php else: ?>
            <?php echo $this->hyperlink($translate('Search the collection'), $this->DreSearchUrl(), ['class' => 'collection-search']); ?>
        <?php endif; ?>
    </div>
</div>

<?php $this->trigger('view.browse.before'); ?>

<?php if (!count($items)): ?>
    <?php // The single-resource-type core search redirects here, so this is where
          // a fruitless site-wide search actually lands. ?>
    <?php echo $this->partial('common/search-empty', [
        'searched' => is_string($query['fulltext_search'] ?? null) && trim($query['fulltext_search']) !== '',
    ]); ?>
<?php else: ?>

<div class="resources <?php echo ($isGrid) ? 'resource-grid' : 'resource-list'; ?>">
    <div class="grid-sizer"></div>
    <div class="gutter-sizer"></div>
    <?php
    $revealIndex = 0;
    foreach ($items as $item):
        echo $this->partial('common/resource-card', array_merge($this->ResourceCardData($item), [
            'bodyTruncate' => $bodyTruncate,
            'isGrid' => $isGrid,
            'reveal' => $revealIndex < 6 ? $revealIndex * 70 : null,
        ]));
        $revealIndex++;
    endforeach; ?>

</div>

<?php endif; ?>

<?php echo ($itemSetShow) ? '</div>' : ''; ?>
<?php $this->trigger('view.browse.after'); ?>

<?php echo $this->pagination('common/pagination-bottom'); ?>
