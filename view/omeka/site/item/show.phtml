<?php
/**
 * Item record — a reading column beside a sticky apparatus rail.
 *
 * The page used to be a single flat column of resource-page blocks inside
 * `.regions-container`, which meant home, browse, item and static pages all had
 * the same silhouette — the thing that makes a collection read like an admin
 * back-end. The record now gets a layout of its own: the intellectual content
 * at a real reading measure, and the apparatus (citation, DOI, licence, access
 * rights, the record's own identifier) in a rail the reader meets without
 * scrolling past it.
 *
 * The rail is theme-provided but does not take the right region over: whatever
 * blocks an admin has configured for "Right sidebar" render below the
 * apparatus. With neither present the rail is dropped entirely and the record
 * takes the full width.
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

// Regions
$mainBlockContent = $this->resourcePageBlocks($item);
$mainHasBlocks = $mainBlockContent->hasBlocks();
$leftSidebarBlockContent = $this->resourcePageBlocks($item, 'left');
$leftSidebarHasBlocks = $leftSidebarBlockContent->hasBlocks();
$rightSidebarBlockContent = $this->resourcePageBlocks($item, 'right');
$rightSidebarHasBlocks = $rightSidebarBlockContent->hasBlocks();

// The apparatus renders nothing when the record carries no citation, DOI,
// licence, access rights or identifier — capture it so an empty one does not
// leave an empty rail behind.
//
// "Save record" is a record action, so it sits in the apparatus beside "Copy
// link", where the sticky rail keeps it in view. Below $lg the rail drops under
// the whole record, so a second copy under the title serves those widths; CSS
// shows one or the other. Without an apparatus it stays under the title.
$saveInRail = (string) $this->partial('common/shortlist-button', ['resource' => $item, 'detail' => true, 'placement' => 'rail']);
$apparatus = trim((string) $this->partial('common/record-apparatus', ['resource' => $item, 'saveButton' => $saveInRail]));
$hasRail = ($apparatus !== '') || $rightSidebarHasBlocks;
?>

<?php echo $this->ResourceTags($item); ?>
<?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 1); ?>

<?php echo $this->partial('common/shortlist-button', ['resource' => $item, 'detail' => true, 'placement' => $apparatus !== '' ? 'narrow' : null]); ?>

<?php $this->trigger('view.show.before'); ?>

<?php if ($mainHasBlocks || $leftSidebarHasBlocks || $hasRail): ?>

    <div class="item-record<?php echo $hasRail ? ' item-record--railed' : ''; ?>">
        <div class="item-record__main">
            <?php if ($leftSidebarHasBlocks && $blockContent = $leftSidebarBlockContent->getBlocks()): ?>
                <div class="metadata item-record__aside-blocks">
                    <?php echo $blockContent; ?>
                </div>
            <?php endif; ?>

            <?php if ($mainHasBlocks && $blockContent = $mainBlockContent->getBlocks()): ?>
                <div class="metadata">
                    <?php echo $blockContent; ?>
                </div>
            <?php endif; ?>
        </div>

        <?php if ($hasRail): ?>
            <aside class="item-record__rail">
                <?php echo $apparatus; ?>

                <?php if ($rightSidebarHasBlocks && $blockContent = $rightSidebarBlockContent->getBlocks()): ?>
                    <div class="metadata item-record__rail-blocks">
                        <?php echo $blockContent; ?>
                    </div>
                <?php endif; ?>
            </aside>
        <?php endif; ?>
    </div>

<?php endif; ?>

<?php $this->trigger('view.show.after'); ?>
