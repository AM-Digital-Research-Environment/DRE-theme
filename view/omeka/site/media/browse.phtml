<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->inlineScript()->appendFile($this->assetUrl('js/masonry.pkgd.min.js'));
$this->inlineScript()->appendFile($this->assetUrl('js/browse.js'));
$this->htmlElement('body')->appendAttribute('class', 'media resource browse');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

// See helper/BrowseLayout.php — resolves grid/list, the ?view= override, and
// the body-property settings that used to be duplicated in every browse template.
$layout = $this->BrowseLayout();
$isGrid = $layout['isGrid'];
$bodyTerm = $layout['bodyTerm'];
$bodyTruncate = $layout['truncate'];

$decoration = $this->themeSetting('image_decoration');
$decorationClass = '';

if (is_array($decoration) && in_array('media', $decoration)) {
    $decorationClass = $isGrid ? 'decoration' : 'decoration decoration--thumbnail';
}
?>

<?php echo $this->pageTitle($translate('Media'), 1); ?>

<?php echo $this->searchFilters(); ?>

<?php echo $this->pagination(); ?>

<div class="browse-controls">
    <?php echo $this->partial('common/browse-layout-toggle', ['layout' => $layout, 'icons' => true]); ?>
    <?php echo $this->browse()->renderSortSelector('medias'); ?>
    <div class="collection-search-container">
        <?php echo $this->hyperlink($translate('Search the collection'), $this->DreSearchUrl(), ['class' => 'collection-search']); ?>
    </div>
</div>

<?php $this->trigger('view.browse.before'); ?>

<div class="resources <?php echo ($isGrid) ? 'resource-grid' : 'resource-list'; ?>">
    <div class="grid-sizer"></div>
    <div class="gutter-sizer"></div>
    <?php
    foreach ($medias as $media):
        $body = $bodyTerm ? $media->value($bodyTerm, ['lang' => ($valueLang)]) : $media->displayDescription(null, ($valueLang));
        $primaryMedia = $media->primaryMedia();
        $thumbnail = '';
        if ($primaryMedia) {
            $altText = $primaryMedia->altText() ?: $primaryMedia->displayTitle() ?: '';
            $thumbnail = $this->thumbnail($primaryMedia, 'large', ['alt' => $altText]);
        }
        echo $this->partial('common/resource-card', [
            'resource' => $media,
            'heading' => $media->displayTitle(null, $valueLang),
            'body' => $body,
            'bodyTruncate' => $bodyTruncate,
            'thumbnail' => $thumbnail,
            'decorationClass' => $decorationClass,
            'isGrid' => $isGrid,
        ]);
    endforeach; ?>

</div>

<?php $this->trigger('view.browse.after'); ?>

<?php echo $this->pagination(); ?>
