<?php
$translate = $this->plugin('translate');
$hyperlink = $this->plugin('hyperlink');
$url = $this->plugin('url');
$format = $this->plugin('TranslateFormat');
$this->htmlElement('body')->appendAttribute('class', 'index search');

?>

<?php echo $this->pageTitle($format->translate('Search results for “%s”', $query), 1); ?>

<?php if (empty($results)): ?>
    <?php echo $this->partial('common/search-empty', ['searched' => true]); ?>
<?php else: ?>
    <?php
    $resourceLabels = [
        'site_pages' => 'Site pages', // @translate
        'items' => 'Items', // @translate
        'item_sets' => 'Item sets', // @translate
        'media' => 'Media', // @translate
    ];
    $resourceControllers = [
        'site_pages' => 'page',
        'items' => 'item',
        'item_sets' => 'item-set',
        'media' => 'media',
    ];
    ?>
    <?php foreach ($results as $resourceName => $result): ?>
        <div class="<?php echo $this->escapeHtmlAttr($resourceName); ?> results">
            <h2><?php echo $this->escapeHtml($translate($resourceLabels[$resourceName])); ?></h2>
            <ul class="resources resource-list">
                <?php foreach ($result['resources'] as $resource): ?>
                    <?php if ('site_pages' === $resourceName): ?>
                        <?php // Site pages are not resource representations — no
                              // thumbnail, tags or resource class — so they keep
                              // their own minimal row rather than the shared card. ?>
                        <li class="site-page resource">
                            <div class="resource__content">
                                <div class="resource__meta">
                                    <?php echo $resource->link($resource->title()); ?>
                                </div>
                            </div>
                        </li>
                    <?php else:
                        echo $this->partial('common/resource-card', $this->ResourceCardData($resource, ['showBody' => false]) + [
                            'tag' => 'li',
                            // Search results are a compact title list — no tag chips.
                            'showTags' => false,
                        ]);
                    endif; ?>
                <?php endforeach; ?>
            </ul>
                <?php // Site pages have their own browse route: through site/resource,
                      // /page/browse is matched by site/page as a page slug and 404s.
                      // (The same slip is in core 4.2.1's template; its controller
                      // redirect uses site/page-browse.) ?>
                <?php echo $hyperlink(
                    $format->translate('View all results (%s total)', $this->FormatNumber($result['total'])),
                    'site_pages' === $resourceName
                        ? $url('site/page-browse', [], ['query' => ['fulltext_search' => $query]], true)
                        : $url(
                            'site/resource',
                            ['controller' => $resourceControllers[$resourceName], 'action' => 'browse'],
                            ['query' => ['fulltext_search' => $query]],
                            true
                        )
                ); ?>
        </div>
    <?php endforeach; ?>
<?php endif; ?>
