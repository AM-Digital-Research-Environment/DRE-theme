<?php
$translate = $this->plugin('translate');
$hyperlink = $this->plugin('hyperlink');
$url = $this->plugin('url');
$this->htmlElement('body')->appendAttribute('class', 'index search');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

?>

<?php echo $this->pageTitle(sprintf($translate('Search results for “%s”'), $query)); ?>

<?php if (empty($results)): ?>
    <?php // Empty state: a quiet pause with a path onward — nothing is wrong,
          // the archive just has no match. The query itself is already restated
          // by the page title above, so don't repeat it here. ?>
    <div class="search-empty">
        <p class="search-empty__lead"><?php echo $translate('Nothing in the collections matched this search.'); ?></p>
        <ul class="search-empty__hints">
            <li><?php echo $translate('Check the spelling, or try another form of the word.'); ?></li>
            <li><?php echo $translate('Fewer, broader terms cast a wider net.'); ?></li>
            <li><?php echo $translate('Names may appear transliterated — try a variant spelling.'); ?></li>
        </ul>
        <div class="search-empty__actions">
            <a class="button" href="<?php echo $this->escapeHtmlAttr($url(
                'site/resource',
                ['controller' => 'item', 'action' => 'search'],
                ['query' => ['fulltext_search' => $query]],
                true
            )); ?>"><?php echo $translate('Refine in advanced search'); ?></a>
            <a class="button btn--secondary" href="<?php echo $this->escapeHtmlAttr($url(
                'site/resource',
                ['controller' => 'item', 'action' => 'browse'],
                [],
                true
            )); ?>"><?php echo $translate('Browse all items'); ?></a>
        </div>
    </div>
<?php else: ?>
    <?php
    $resourceLabels = [
        'site_pages' => 'Site pages', // @translate
        'items' => 'Items', // @translate
        'item_sets' => 'Item sets', // @translate
        'media' => 'Media', // @translate
    ];
    $resourceControllers = [
        'site_pages' => 'page',
        'items' => 'item',
        'item_sets' => 'item-set',
        'media' => 'media',
    ];
    ?>
    <?php foreach ($results as $resourceName => $result): ?>
        <div class="<?php echo $resourceName; ?> results">
            <h2><?php echo $translate($resourceLabels[$resourceName]); ?></h2>
            <ul class="resources resource-list">
                <?php foreach ($result['resources'] as $resource):
                    $primaryMedia = $resource->primaryMedia();
                    ?>
                    <li class="item resource">
                        <!-- Thumbnail -->
                        <?php if ($primaryMedia): ?>
                            <div class="resource__thumbnail">
                                <?php $altText = $primaryMedia->altText() ?: $primaryMedia->displayTitle() ?: ''; ?>
                                <?php echo $resource->linkRaw($this->thumbnail($primaryMedia, 'large', ['alt' => $altText])); ?>
                            </div>
                        <?php endif; ?>

                        <!-- Content -->
                        <div class="resource__content">
                            <!-- Metadata -->
                            <div class="resource__meta">
                                <?php
                                if ($resourceName === 'site_pages') {
                                    echo $resource->link($resource->title());
                                } else {
                                    echo $resource->link($resource->displayTitle(null, $valueLang)); 
                                }
                                ?>
                            </div>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ul>
                <?php echo $hyperlink(
                    sprintf($translate('View all results (%s total)'), $result['total']),
                    $url(
                        'site/resource',
                        ['controller' => $resourceControllers[$resourceName], 'action' => 'browse'],
                        ['query' => ['fulltext_search' => $query]],
                        true
                    )
                ); ?>
        </div>
    <?php endforeach; ?>
<?php endif; ?>
