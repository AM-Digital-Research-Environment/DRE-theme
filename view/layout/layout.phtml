<?php
$siteTitle = $site->title();
$userBar = $this->userBar();

// Is this the site's home page? Used to choose the hero vs. masthead banner and
// to let the hero own the page <h1> (the header drops to a plain home link there).
// Detected from the request path — the home page is served at the site root
// (e.g. /s/amira) or at its own slug (/s/amira/page/<homepage-slug>). This avoids
// the MVC route match (the `status` view helper does not expose getRouteMatch())
// and is wrapped so a detection hiccup can never take a page down: it just falls
// back to the non-home layout (slim masthead + header <h1>).
$isHome = false;
try {
    $currentPath = rtrim((string) parse_url((string) $this->serverUrl(true), PHP_URL_PATH), '/');
    $sitePath    = rtrim((string) parse_url((string) $site->url(), PHP_URL_PATH), '/');
    if ($currentPath !== '' && $sitePath !== '') {
        if ($currentPath === $sitePath) {
            $isHome = true; // site root
        } elseif (method_exists($site, 'homepage') && ($homepage = $site->homepage())) {
            $isHome = ($currentPath === $sitePath . '/page/' . $homepage->slug());
        }
    }
} catch (\Throwable $e) {
    $isHome = false;
}

// Brand colour: the SCSS derives every primary variant (--primary,
// --primary-hover, --primary-active, --focus-ring, glows, …) from a single
// --primary-base seed via color-mix(in oklab, …). PHP only injects the seed
// (defaulting to Uni-Grün) plus a contrast-safe label colour. Changing the
// "Brand colour" in theme settings re-tints the entire palette automatically.
$primaryColor = $this->themeSetting('primary_color') ?: '#009260';

$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/style.css'));
// NOTE: Omeka core's FontAwesome webfont (css/iconfonts.css + fa-solid-900.woff2,
// ~91 KiB/page) is intentionally NOT loaded. The theme draws all of its icons as
// inline Lucide-style SVG (see asset/img/*.svg and the svg-icon mask mixin
// in _mixins.scss); the few former FA ::before/::after
// glyphs (checkbox tick, menu chevrons, carousel arrows, ToC markers) are now
// painted with that mask. Omeka's public user bar uses its own user-bar.css and
// no icon font. If a future module needs FA glyphs, re-add the line below.
// $this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
// Webfonts are SELF-HOSTED (design-review F10). The @font-face rules live in the
// compiled style.css (asset/sass/base/_fonts.scss) and point at asset/fonts/*.woff2,
// so there is NO render-blocking third-party stylesheet and no extra DNS+TLS hop /
// single point of failure on the LCP path. The woff2 are the byte-identical Bunny
// Fonts files (a GDPR-compliant mirror of Google Fonts); serving them from our own
// origin removes the third-party font origin entirely — a stronger privacy story
// for an EU (Bayreuth) deployment. Shipped: Spectral (display serif) upright
// 400/600/700/800 + italic 400, and Hanken Grotesk (body/UI sans) 400/500/600/700 +
// italic 400, latin + latin-ext subsets. To add a weight/style: drop its woff2 in
// asset/fonts/ and add a @font-face to _fonts.scss (then rebuild).
// jQuery + Omeka core global.js, in the head on every public page.
//
// AUDIT (design-review F9, "drop jQuery if nothing public calls $"): the
// precondition is NOT met — public pages call `$` SYNCHRONOUSLY, so jQuery must
// stay loaded (and in <head>, before those inline scripts). The dependencies:
//   • Omeka core `global.js` — the advanced-search form: add/remove-value
//     (`.value.clone()`), query-type input disabling, and the pre-submit
//     `cleanSearchQuery()` (search-correctness critical), plus expand/collapse.
//   • Omeka core `common/advanced-search.phtml` — an inline
//     `<script>Omeka.prepareSearchForm($('#advanced-search'));</script>` that
//     runs during parse, so deferring jQuery would throw `$ is not defined`.
//   • This theme's `common/advanced-search/item-sets.phtml` — an inline
//     `$('#content').on('change', …)` handler.
// Our OWN public scripts (navigation.js, theme-toggle.js, back-to-top.js, …) are
// all vanilla, and the sibling modules (DRE-Search/Svelte, ResourceVisualizations)
// are jQuery-free. So the only blocker is the core advanced-search form. Dropping
// (or deferring) jQuery therefore requires first reimplementing that form's JS in
// vanilla — out of scope for a P3 perf item; re-run this audit before retrying.
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
$this->jsTranslate();

// DRESearch module: inject the Typesense search bundle into <head> here (before
// the head is rendered below), so the header search bar — which renders later as
// layout chrome — has the bundle. Guarded so the theme works without the module.
if ($this->getHelperPluginManager()->has('dreSearchAssets')) {
	echo $this->dreSearchAssets();
}

$this->trigger('view.layout');

if ($userBar) {
	$this->htmlElement('body')->appendAttribute('class', 'user-bar');
}
?>

<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html')->setAttribute('lang', $this->lang()); ?>
	<head>
		<?php // Preload the two above-the-fold webfont faces (Hanken Grotesk 400
		      // body/UI + Spectral 600 display) so they fetch in parallel with the
		      // CSS instead of waiting for it to download and parse first — shortens
		      // the FCP/LCP font chain. Same-origin now (self-hosted), so no font-CDN
		      // preconnect is needed; `crossorigin` is still required so the preload
		      // matches the @font-face's anonymous CORS fetch (else it double-fetches).
		      // assetUrl() is emitted UN-versioned to match the bare url() in style.css. ?>
		<link rel="preload" as="font" type="font/woff2" crossorigin
			href="<?php echo $this->escapeHtmlAttr($this->assetUrl('fonts/hanken-grotesk-latin-400-normal.woff2', null, false, false)); ?>">
		<link rel="preload" as="font" type="font/woff2" crossorigin
			href="<?php echo $this->escapeHtmlAttr($this->assetUrl('fonts/spectral-latin-600-normal.woff2', null, false, false)); ?>">
		<?php echo $this->headMeta(); ?>
		<?php echo $this->headTitle(); ?>
		<?php echo $this->headLink(); ?>
		<?php echo $this->headStyle(); ?>
		<?php echo $this->headScript(); ?>

		<style type="text/css" media="screen">
			:root {
				/* Single brand seed; SCSS derives every primary variant via color-mix(in oklab, …) */
				--primary-base: <?php echo $this->escapeHtml($primaryColor); ?>;
				--primary-contrast: <?php echo $this->escapeHtml($this->ContrastColor($primaryColor, ['#ffffff', '#1a1a1a'])); ?>;
			}
		</style>
	</head>

	<?php echo $this->htmlElement('body'); ?>
		<script>
		// Mark JS-capable up front so the header can gate the inline menu's
		// visibility until navigation.js classifies it (menu-flash fix #06);
		// without JS the class is absent and the no-JS wrap fallback applies.
		document.documentElement.classList.add('js');
		// Apply the saved theme synchronously, before first paint, to prevent a
		// flash of the wrong theme. Mirrors getPreferredTheme() in theme-toggle.js.
		(function () {
			try {
				var stored = localStorage.getItem('dre-theme-preference');
				var theme = (stored === 'light' || stored === 'dark')
					? stored
					: (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				// Set on <html> so the root color-scheme (scrollbars / native UI)
				// matches the chosen theme, and on <body> for subtree theming and
				// chart modules that observe body[data-theme].
				document.documentElement.setAttribute('data-theme', theme);
				document.body.setAttribute('data-theme', theme);
			} catch (e) {}
		})();
		</script>
		<a id="skipnav" href="#content"><?php echo $this->translate('Skip to main content'); ?></a>

		<?php echo $this->partial('common/header', ['userBar' => $userBar, 'site' => $site, 'isHome' => $isHome]); ?>

		<?php echo $this->partial('common/banner', ['site' => $site, 'isHome' => $isHome]); ?>

		<div id="content" class="container" role="main" tabindex="-1">
			<?php echo $this->content; ?>
		</div>

		<?php echo $this->partial('common/footer', ['site' => $site]); ?>

		<button type="button" class="back-to-top" data-back-to-top
			aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Back to top')); ?>">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
				fill="none" stroke="currentColor" stroke-width="2.25"
				stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m18 15-6-6-6 6"/>
			</svg>
		</button>

		<?php
		echo $this->inlineScript()
			->prependFile($this->assetUrl('js/theme-toggle.js'))
			->prependFile($this->assetUrl('js/navigation.js'))
			->prependFile($this->assetUrl('js/back-to-top.js'))
			->prependFile($this->assetUrl('js/script.js'))
			->prependFile($this->assetUrl('js/utils.js'));
		?>
	</body>
</html>
