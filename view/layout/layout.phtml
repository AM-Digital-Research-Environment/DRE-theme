<?php
$siteTitle = $site->title();
$userBar = $this->userBar();

// Is this the site's home page? Chooses the full masthead vs. the slim strip and
// lets the masthead own the page <h1>. The detection lives in
// helper/IsHomePage.php because the page-title
// block needs the same answer and cannot read a local from this file — Omeka
// renders the content before the layout.
$isHome = $this->IsHomePage();

// Masthead brand presence (A quiet / B balanced / C bold). Purely a token
// switch: abstracts/variables/_colors.scss redefines the --masthead-* / --flag /
// --numeral / --cta-* roles per value, so nothing else in the theme knows which
// treatment is active.
//
// This fallback MUST track elements.masthead_brand.attributes.value in
// config/theme.ini. theme.ini's value only pre-fills the admin form on a fresh
// configure — it is not what themeSetting() falls back to — so an install that
// has never saved theme settings (masthead_brand simply absent from
// theme_settings_dre-theme) is served whatever is hard-coded here. When 2.24.0
// moved the default to "bold" and left this line at "balanced", every existing
// site kept the band that follows --surface: the deep plate shipped and no
// visitor saw it.
$brandPresence = (string) $this->themeSetting('masthead_brand', 'bold');
if (!in_array($brandPresence, ['quiet', 'balanced', 'bold'], true)) {
    $brandPresence = 'bold';
}
$this->htmlElement('body')->setAttribute('data-brand', $brandPresence);

// Brand colour: the SCSS derives every primary variant (--primary,
// --primary-hover, --primary-active, --focus-ring, glows, …) from a single
// --primary-base seed via color-mix(in oklab, …). PHP only injects the seed
// (defaulting to Uni-Grün) plus a contrast-safe label colour. Changing the
// "Brand colour" in theme settings re-tints the entire palette automatically.
$primaryColor = (string) ($this->themeSetting('primary_color') ?: '#009260');
if (!preg_match('/^#[0-9a-f]{6}$/i', $primaryColor)) {
    $primaryColor = '#009260';
}

// ===== Installable PWA ====================================================
// Build a per-site Web App Manifest in PHP and emit it as a JSON island in
// <head>; pwa-install.js reads it, absolutises the URLs, and attaches it as a
// same-origin blob: URL at runtime (a theme can't register an Omeka route to
// serve a real .webmanifest, and per-site values rule out a static file). The
// whole block is wrapped so a hiccup can only drop the PWA — never 500 the page
// (this layout renders on every request). Opt out via the "Progressive Web App"
// theme setting; default on.
$pwaEnabled = (bool) $this->themeSetting('pwa_enable', true);
$pwaShortName = '';
$pwaManifestJson = '';
if ($pwaEnabled) {
    try {
        $slug = $site->slug();
        // Absolute site base with a trailing slash — used verbatim for id /
        // start_url / scope (scope must be a prefix of start_url).
        $siteBase = rtrim((string) $this->url('site', ['site-slug' => $slug], ['force_canonical' => true]), '/') . '/';

        $pwaShortName = trim((string) $this->themeSetting('pwa_short_name', ''));
        if ($pwaShortName === '') {
            $pwaShortName = $site->title();
        }

        // Locale → lang/dir. All shipped locales are LTR; derive dir defensively.
        $lang = $this->lang() ?: 'en';
        $rtl = ['ar', 'arc', 'dv', 'fa', 'ha', 'he', 'khw', 'ks', 'ku', 'ps', 'sd', 'ug', 'ur', 'yi'];
        $dir = in_array(strtolower(substr($lang, 0, 3)), $rtl, true)
            || in_array(strtolower(substr($lang, 0, 2)), $rtl, true) ? 'rtl' : 'ltr';

        $pwaIcon = function ($file, $sizes, $purpose) {
            return [
                'src' => $this->assetUrl('img/pwa/' . $file),
                'sizes' => $sizes,
                'type' => 'image/png',
                'purpose' => $purpose,
            ];
        };

        // Browse / Search launcher shortcuts (absolute). Nested try/catch so a
        // routing hiccup drops only the shortcuts, not the whole manifest.
        $pwaShortcuts = [];
        try {
            $shortcutIcon = [[
                'src' => $this->assetUrl('img/pwa/icon-192.png'),
                'sizes' => '192x192',
                'type' => 'image/png',
            ]];
            $pwaShortcuts = [
                [
                    'name' => $this->translate('Browse the collection'),
                    'short_name' => $this->translate('Browse'),
                    'url' => $this->url('site/resource', ['site-slug' => $slug, 'controller' => 'item', 'action' => 'browse'], ['force_canonical' => true]),
                    'icons' => $shortcutIcon,
                ],
                [
                    'name' => $this->translate('Search'),
                    'short_name' => $this->translate('Search'),
                    'url' => $this->DreSearchUrl(),
                    'icons' => $shortcutIcon,
                ],
            ];
        } catch (\Throwable $e) {
            $pwaShortcuts = [];
        }

        $pwaManifest = [
            'id' => $siteBase,
            'name' => $site->title(),
            'short_name' => $pwaShortName,
            'start_url' => $siteBase,
            'scope' => $siteBase,
            'display' => 'standalone',
            'display_override' => ['standalone', 'minimal-ui'],
            // theme_color / background_color from the light surface tokens
            // (--surface #fdfcf9 / --background #f8f6f1); the splash reads as the
            // page ground with a near-white toolbar.
            'theme_color' => '#fdfcf9',
            'background_color' => '#f8f6f1',
            'lang' => $lang,
            'dir' => $dir,
            'categories' => ['education', 'reference', 'books'],
            'icons' => [
                $pwaIcon('icon-192.png', '192x192', 'any'),
                $pwaIcon('icon-512.png', '512x512', 'any'),
                $pwaIcon('maskable-192.png', '192x192', 'maskable'),
                $pwaIcon('maskable-512.png', '512x512', 'maskable'),
                $pwaIcon('monochrome-512.png', '512x512', 'monochrome'),
            ],
        ];
        $summary = method_exists($site, 'summary') ? trim((string) $site->summary()) : '';
        if ($summary !== '') {
            $pwaManifest['description'] = $summary;
        }
        if ($pwaShortcuts) {
            $pwaManifest['shortcuts'] = $pwaShortcuts;
        }

        // JSON_HEX_TAG neutralises "<" (so a stray "</script>" can't break out of
        // the island); slashes/unicode stay literal for a compact, readable blob.
        $pwaManifestJson = json_encode($pwaManifest, JSON_HEX_TAG | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
        // Keep all three gates (head island, header button, body script)
        // consistent: if encoding somehow fails, disable the feature wholesale.
        if ($pwaManifestJson === false) {
            $pwaEnabled = false;
            $pwaManifestJson = '';
        }
    } catch (\Throwable $e) {
        $pwaEnabled = false;
        $pwaManifestJson = '';
    }
}

$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/style.css'));
// NOTE: Omeka core's FontAwesome webfont (css/iconfonts.css + fa-solid-900.woff2,
// ~91 KiB/page) is intentionally NOT loaded. The theme draws all of its icons as
// inline Lucide-style SVG and the svg-icon mask mixin in _mixins.scss; the few
// former FA ::before/::after
// glyphs (checkbox tick, menu chevrons, carousel arrows, ToC markers) are now
// painted with that mask. Omeka's public user bar uses its own user-bar.css and
// no icon font. If a future module needs FA glyphs, re-add the line below.
// $this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
// Webfonts are SELF-HOSTED (design-review F10). The @font-face rules live in the
// compiled style.css (asset/sass/base/_fonts.scss) and point at asset/fonts/*.woff2,
// so there is NO render-blocking third-party stylesheet and no extra DNS+TLS hop /
// single point of failure on the LCP path. The woff2 are the byte-identical Bunny
// Fonts files (a GDPR-compliant mirror of Google Fonts); serving them from our own
// origin removes the third-party font origin entirely — a stronger privacy story
// for an EU (Bayreuth) deployment. Shipped: Spectral (display serif) upright
// 400/600/700/800 + italic 400, and Hanken Grotesk (body/UI sans) 400/500/600/700 +
// italic 400, latin + latin-ext subsets. To add a weight/style: drop its woff2 in
// asset/fonts/ and add a @font-face to _fonts.scss (then rebuild).
// jQuery + Omeka core global.js stay available for core and third-party module
// templates. Theme-authored scripts are dependency-free; legacy advanced-search
// routes now redirect to the DRE Search module.
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
$this->jsTranslate();

// DRE Search module: inject the Typesense search bundle into <head> here (before
// the head is rendered below), so the header search bar — which renders later as
// layout chrome — has the bundle. Guarded so the theme works without the module.
if ($this->getHelperPluginManager()->has('dreSearchAssets')) {
	echo $this->dreSearchAssets();
}

$this->trigger('view.layout');

if ($userBar) {
	$this->htmlElement('body')->appendAttribute('class', 'user-bar');
}
?>

<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html')->setAttribute('lang', $this->lang()); ?>
	<head>
		<?php // Preload the two above-the-fold webfont faces (Hanken Grotesk 400
		      // body/UI + Spectral 600 display) so they fetch in parallel with the
		      // CSS instead of waiting for it to download and parse first — shortens
		      // the FCP/LCP font chain. Same-origin now (self-hosted), so no font-CDN
		      // preconnect is needed; `crossorigin` is still required so the preload
		      // matches the @font-face's anonymous CORS fetch (else it double-fetches).
		      // assetUrl() is emitted UN-versioned to match the bare url() in style.css. ?>
		<link rel="preload" as="font" type="font/woff2" crossorigin
			href="<?php echo $this->escapeHtmlAttr($this->assetUrl('fonts/hanken-grotesk-latin-400-normal.woff2', null, false, false)); ?>">
		<link rel="preload" as="font" type="font/woff2" crossorigin
			href="<?php echo $this->escapeHtmlAttr($this->assetUrl('fonts/spectral-latin-600-normal.woff2', null, false, false)); ?>">
		<?php echo $this->headMeta(); ?>
		<?php echo $this->headTitle(); ?>
		<?php echo $this->headLink(); ?>
		<?php echo $this->headStyle(); ?>
		<?php echo $this->headScript(); ?>

		<?php if ($pwaEnabled && $pwaManifestJson): ?>
		<?php // ===== Installable PWA — theme-color (light/dark), Apple/mobile
		      // web-app metas, favicon + apple-touch icons, and the manifest
		      // island. There is deliberately NO <link rel="manifest"> here: the
		      // manifest is minted as a same-origin blob: URL by pwa-install.js
		      // (body end), because it must carry absolute per-site URLs and a
		      // data: manifest's opaque origin would make Chrome reject it. ?>
		<meta name="theme-color" content="#fdfcf9" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0e1612" media="(prefers-color-scheme: dark)">
		<meta name="mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="default">
		<meta name="apple-mobile-web-app-title" content="<?php echo $this->escapeHtmlAttr($pwaShortName); ?>">
		<link rel="apple-touch-icon" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/apple-touch-icon.png')); ?>">
		<?php // Browser-tab favicon: the official Africa Multiple colour compass on
		      // white (asset/img/pwa/favicon-source.png, resized), so the tab uses the
		      // real brand mark and stays visible on any tab strip. The installed-app
		      // icons (manifest + apple-touch) keep the green tile. ?>
		<link rel="icon" type="image/png" sizes="48x48" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon-48.png')); ?>">
		<link rel="icon" type="image/png" sizes="32x32" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon-32.png')); ?>">
		<link rel="icon" type="image/png" sizes="16x16" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon-16.png')); ?>">
		<script type="application/json" id="dre-pwa-manifest"><?php echo $pwaManifestJson; ?></script>
		<?php endif; ?>

		<style type="text/css" media="screen">
			:root {
				/* Single brand seed; SCSS derives every primary variant via color-mix(in oklab, …) */
				--primary-base: <?php echo $this->escapeHtml($primaryColor); ?>;
				--primary-contrast: <?php echo $this->escapeHtml($this->ContrastColor($primaryColor, ['#ffffff', '#1a1a1a'])); ?>;
			}
		</style>
	</head>

	<?php echo $this->htmlElement('body'); ?>
		<script>
		// Mark JS-capable up front so the header can gate the inline menu's
		// visibility until navigation.js classifies it (menu-flash fix #06);
		// without JS the class is absent and the no-JS wrap fallback applies.
		document.documentElement.classList.add('js');
		// Apply the saved theme synchronously, before first paint, to prevent a
		// flash of the wrong theme. Mirrors getPreferredTheme() in theme-toggle.js.
		(function () {
			try {
				var stored = localStorage.getItem('dre-theme-preference');
				var theme = (stored === 'light' || stored === 'dark')
					? stored
					: (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				// Set on <html> so the root color-scheme (scrollbars / native UI)
				// matches the chosen theme, and on <body> for subtree theming and
				// chart modules that observe body[data-theme].
				document.documentElement.setAttribute('data-theme', theme);
				document.body.setAttribute('data-theme', theme);
			} catch (e) {}
		})();
		</script>
		<a id="skipnav" href="#content"><?php echo $this->translate('Skip to main content'); ?></a>

		<?php echo $this->partial('common/header', ['userBar' => $userBar, 'site' => $site, 'isHome' => $isHome, 'pwaEnabled' => $pwaEnabled]); ?>

		<?php echo $this->partial('common/banner', ['site' => $site, 'isHome' => $isHome]); ?>

		<main id="content" class="container" tabindex="-1">
			<?php echo $this->content; ?>
		</main>

		<?php echo $this->partial('common/footer', ['site' => $site]); ?>

		<button type="button" class="back-to-top" data-back-to-top
			aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Back to top')); ?>">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
				fill="none" stroke="currentColor" stroke-width="2.25"
				stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m18 15-6-6-6 6"/>
			</svg>
		</button>

		<?php
		echo $this->inlineScript()
			->prependFile($this->assetUrl('js/theme-toggle.js'))
			->prependFile($this->assetUrl('js/navigation.js'))
			->prependFile($this->assetUrl('js/back-to-top.js'))
			->prependFile($this->assetUrl('js/script.js'))
			->prependFile($this->assetUrl('js/utils.js'));
		?>
		<?php if ($pwaEnabled): ?>
		<?php // pwa-install.js — vanilla, deferred; reads the manifest island,
		      // attaches the blob: manifest, and reveals the header install button
		      // only when the browser can actually install (or on iOS Safari). ?>
		<script defer src="<?php echo $this->escapeHtmlAttr($this->assetUrl('js/pwa-install.js')); ?>"></script>
		<?php endif; ?>
	</body>
</html>
