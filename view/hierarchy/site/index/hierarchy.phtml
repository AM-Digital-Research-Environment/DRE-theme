<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$this->headLink()->appendStylesheet($this->assetUrl('css/hierarchy.css', 'Hierarchy'));
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource browse hierarchy-module');
?>
<?php
$tree = $this->HierarchyTree($hierarchyGrouping, $valueLang);
// Title the page from the authorized sets the tree already read: the grouping's
// raw item-set association is a lazy proxy, and initialising it for a set the
// visitor may not see throws instead of rendering.
$title = $hierarchyGrouping->getLabel();
if (!$title && ($reference = $hierarchyGrouping->getItemSet())) {
    $setId = (int) $reference->id();
    foreach ($tree['itemSets'] as $set) {
        if ($set->id() === $setId) {
            $title = $set->displayTitle(null, $valueLang);
            break;
        }
    }
    if (!$title) {
        try {
            $title = $reference->displayTitle(null, $valueLang);
        } catch (\Throwable $e) {
            $title = $translate('[Untitled]');
        }
    }
}
if ($title) {
    echo $this->pageTitle($title, 1);
}
?>

<div class="hierarchy-row">
    <div class="hierarchy-sidebar-content"><div class="hierarchy-metadata"><div class="hierarchy-filters">
        <?php if ($this->siteSetting('hierarchy_show_label') && $hierarchyGrouping->getHierarchy()->getLabel()): ?>
            <h2><?php echo $escape($hierarchyGrouping->getHierarchy()->getLabel()); ?></h2>
        <?php endif; ?>
        <?php echo $this->partial('common/hierarchy-tree', ['nodes' => $tree['nodes']]); ?>
    </div>
    <?php if ($this->siteSetting('hierarchy_display_itemSets') && $tree['itemSets']): ?>
        <div class="hierarchy-item-sets">
            <?php echo $escape($translate('Contains resources from:')); ?>
            <?php foreach ($tree['itemSets'] as $index => $set): ?>
                <?php echo $index ? ', ' : ''; ?><?php echo $set->link($set->displayTitle()); ?>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
    </div></div>

    <div class="hierarchy-main-content">
        <?php
        // If hierarchy_show_itemset_metadata checked, display item set metadata
        if ($this->siteSetting('hierarchy_show_itemSet_metadata') && $itemSet):
            ['heading' => $heading, 'body' => $body, 'thumbnail' => $setThumbnail] = $this->ResourceCardData($itemSet, ['thumbnailSize' => 'medium']);
        ?>
        <ul class="resource-list">
        <li class="item-set resource">
            <div class="hierarchy-itemset-metadata">
                <?php
                $linkContent = sprintf('%s<span class="resource-name">%s</span>',
                    $setThumbnail,
                    $escape($heading));
                echo $itemSet->linkRaw($linkContent, null, ['class' => 'resource-link']);
                ?>
                <?php if ($body): ?>
                <div class="description"><?php echo $escape($body); ?></div>
                <?php endif; ?>
            </div>
        </li>
        </ul>
        <?php endif; ?>

        <div class="hierarchy-items">
            <?php echo '<h3>' . $escape($translate('Items')) . '</h3>'; ?>

            <?php echo $this->searchFilters(); ?>

            <div class="browse-controls">
                <?php echo $this->pagination(); ?>
                <?php echo $this->hyperlink($translate('Search the collection'), $this->DreSearchUrl(), ['class' => 'collection-search']); ?>
                <?php echo $this->browse()->renderSortSelector('items'); ?>
            </div>

            <?php $this->trigger('view.browse.before'); ?>
            <ul class="resource-list">
                <?php
                $bodyTruncate = $this->themeSetting('truncate_body_property');
                foreach ($items as $item):
                    echo $this->partial('common/resource-card', $this->ResourceCardData($item, ['thumbnailSize' => 'square']) + [
                        'bodyTruncate' => $bodyTruncate,
                        'tag' => 'li',
                        'isGrid' => false,
                    ]);
                endforeach; ?>
            </ul>
            <div class="browse-controls">
                <?php echo $this->pagination(); ?>
            </div>
            <?php $this->trigger('view.browse.after'); ?>
        </div>
    </div>
</div>
