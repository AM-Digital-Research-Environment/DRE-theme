<?php
$translate = $this->plugin('translate');
// A browse page shows the pager above and below its results: two navigation
// landmarks need two names. The top/bottom wrappers (pagination-top.phtml,
// pagination-bottom.phtml) set $position; a lone pager keeps the plain name.
$position = $position ?? null;
$landmark = match ($position) {
    'top' => $translate('Pagination, top'),
    'bottom' => $translate('Pagination, bottom'),
    default => $translate('Pagination'),
};
?>
<nav class="pagination" aria-label="<?php echo $this->escapeHtmlAttr($landmark); ?>">
    <?php if ($totalCount): ?>

        <?php
        $from = $offset + 1;
        $to = ($currentPage < $pageCount) ? $offset + $perPage : $totalCount;
        ?>
        <span class="row-count"><?php echo sprintf($translate('%1$s–%2$s of %3$s'), $from, $to, $totalCount); ?></span>

        <?php if ($pageCount > 1): ?>

            <div class="pager-wrapper">
                <!-- Prev Button -->
                <?php if ($currentPage != 1): ?>
                    <?php echo $this->hyperlink('', $previousPageUrl, ['class' => 'previous o-icon-prev button', 'title' => $translate('Previous'), 'aria-label' => $translate('Previous')]); ?>
                <?php else: ?>
                    <?php // A span cannot be `disabled`; it is announced as a link that is unavailable. ?>
                    <span class="previous o-icon-prev button disabled" role="link" aria-disabled="true" aria-label="<?php echo $this->escapeHtmlAttr($translate('Previous')); ?>"></span>
                <?php endif; ?>

                <!-- Pager -->
                <form class="pager" method="GET" action="">
                    <?php echo $this->queryToHiddenInputs(['page']); ?>
                    <label>
                        <?php echo $translate('Page'); ?>
                        <input type="text" name="page" class="page-input-top" value="<?php echo (int) $currentPage; ?>" size="4" <?php echo ($pageCount == 1) ? 'readonly' : ''; ?> aria-label="<?php echo $this->escapeHtmlAttr($translate('Page')); ?>">
                    </label>
                    <span class="page-count"><?php echo sprintf($translate('of %s'), $pageCount); ?></span>
                    <input type="submit" class="gotopage-btn" value="<?php echo $this->escapeHtmlAttr($translate('Go')); ?>">
                </form>

                <!-- Next Button -->
                <?php if ($currentPage < $pageCount): ?>
                    <?php echo $this->hyperlink('', $nextPageUrl, ['class' => 'next o-icon-next button', 'title' => $translate('Next'), 'aria-label' => $translate('Next')]); ?>
                <?php else: ?>
                    <span class="next o-icon-next button disabled" role="link" aria-disabled="true" aria-label="<?php echo $this->escapeHtmlAttr($translate('Next')); ?>"></span>
                <?php endif; ?>
            </div>

        <?php endif; ?>

    <?php else: ?>
        <?php echo $translate('0 results'); ?>
    <?php endif; ?>
</nav>
