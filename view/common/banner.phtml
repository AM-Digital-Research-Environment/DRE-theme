<?php
/**
 * Site masthead — typographic.
 *
 * Photography-free, and carried by type and rule rather than a colour fill:
 * eyebrow → display title → 3px brand flag → lede → SEARCH FIELD, over a
 * hairline strip of corpus counts in tabular numerals. The old earth-tone wash
 * is still available (the "Banner wash" setting) but is no longer the page's
 * only visual idea.
 *
 *  • Home  → the full masthead; carries the page <h1> and the search field.
 *  • Other → a slim strip that keeps the site title visible across the site.
 *
 * Brand presence (quiet / balanced / bold) is a token switch handled entirely
 * in CSS via data-brand on <body> — see abstracts/variables/_colors.scss. This
 * template does not know which treatment is active.
 *
 * Copy is overridable from the theme's "Banner" settings; with nothing set it
 * falls back to the site title so the masthead is meaningful out of the box.
 */

$escHtml   = $this->plugin('escapeHtml');
$escAttr   = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$isHome = isset($isHome) ? (bool) $isHome : false;
$site   = isset($site) ? $site : $this->currentSite();

// Interior pages can opt out of the masthead (default on for fresh installs).
$showInterior = !in_array((string) $this->themeSetting('banner_show_interior', '1'), ['0', ''], true);
if (!$isHome && !$showInterior) {
    return;
}

$siteTitle = $site ? $site->title() : '';
$heading   = $this->themeSetting('banner_heading') ?: $siteTitle;
if ($heading === '' || $heading === null) {
    return; // nothing to show, no point rendering an empty band
}

$eyebrow = $this->themeSetting('banner_eyebrow');
if ($eyebrow === null) {
    $eyebrow = $translate('Digital Research Environment');
}
$tagline     = $this->themeSetting('banner_description');
$buttonLabel = $this->themeSetting('banner_button_label');
$buttonLink  = $this->themeSetting('banner_button_link');

// The optional pre-2.22 wash. Off by default: the masthead is typographic now.
$showWash = in_array((string) $this->themeSetting('banner_wash', '0'), ['1'], true);

$variant = $isHome ? 'home' : 'page';

// ===== Search =============================================================
// The first screen has to offer a field. Target the federated search when the
// DRE-Search module is installed (its Svelte client reads ?q=), and core item
// browse otherwise (?fulltext_search=), so the masthead works on a bare theme.
$searchAction = null;
$searchParam  = 'fulltext_search';
$hasDreSearch = $this->getHelperPluginManager()->has('dreSearchAssets');
if ($isHome) {
    try {
        if ($hasDreSearch && $site) {
            $searchAction = rtrim((string) $site->url(), '/') . '/dre-search';
            $searchParam  = 'q';
        } elseif ($site) {
            $searchAction = $this->url(
                'site/resource',
                ['site-slug' => $site->slug(), 'controller' => 'item', 'action' => 'browse']
            );
        }
    } catch (\Throwable $e) {
        // A routing hiccup drops the field, never the masthead.
        $searchAction = null;
    }
}

// The CTA is now secondary to the search field, so it only renders when an
// admin has explicitly set a link — no auto-default to /dre-search any more
// (that is what the field itself does).

// Optional standing note beside the headline ("Open access", licensing, …).
$asideTitle = trim((string) $this->themeSetting('banner_aside_title', ''));
$asideText  = trim((string) $this->themeSetting('banner_aside_text', ''));

// Home-only corpus-count strip. All the sourcing (cache → module precompute →
// Omeka API fallback) and its error handling live in helper/CollectionStats.php
// — it returns [] on any hiccup, so the masthead still renders.
$stats = [];
$showStats = $isHome
    && !in_array((string) $this->themeSetting('banner_show_stats', '1'), ['0', ''], true);
if ($showStats) {
    $stats = $this->CollectionStats($site ? $site->id() : null);
}

// Locale-aware thousands separators. number_format() is locale-blind — it always
// renders 1,234 in the US convention, which is wrong for a German deployment
// (1.234) and for the theme's other locales.
$formatNumber = static function ($value): string {
    if (class_exists(\NumberFormatter::class)) {
        $formatter = new \NumberFormatter(\Locale::getDefault(), \NumberFormatter::DECIMAL);
        $formatted = $formatter->format((int) $value);
        if (false !== $formatted) {
            return (string) $formatted;
        }
    }
    return number_format((int) $value);
};
?>
<div class="site-banner site-banner--<?php echo $variant; ?>">
    <?php if ($showWash): ?>
        <?php // Optional decorative earth-tone wash (green → gold → braun). ?>
        <div class="site-banner__art" aria-hidden="true"></div>
    <?php endif; ?>

    <?php if ($isHome): ?>
    <div class="container site-banner__inner">
        <div class="site-banner__lead">
            <div class="site-banner__headline">
                <?php if ($eyebrow): ?>
                    <p class="site-banner__eyebrow"><?php echo $escHtml($eyebrow); ?></p>
                <?php endif; ?>

                <?php // The one <h1> on the home page. The page-title block
                      // stands down here (see common/block-layout/page-title). ?>
                <h1 class="site-banner__title"><?php echo $escHtml($heading); ?></h1>

                <div class="site-banner__flag" aria-hidden="true"></div>

                <?php if ($tagline): ?>
                    <p class="site-banner__lede"><?php echo nl2br($escHtml($tagline)); ?></p>
                <?php endif; ?>
            </div>

            <?php if ($asideTitle || $asideText): ?>
                <aside class="site-banner__aside">
                    <?php if ($asideTitle): ?>
                        <p class="site-banner__aside-title"><?php echo $escHtml($asideTitle); ?></p>
                    <?php endif; ?>
                    <?php if ($asideText): ?>
                        <p class="site-banner__aside-text"><?php echo nl2br($escHtml($asideText)); ?></p>
                    <?php endif; ?>
                </aside>
            <?php endif; ?>
        </div>

        <?php if ($searchAction): ?>
            <form class="site-banner__search" role="search" method="GET" action="<?php echo $escAttr($searchAction); ?>">
                <label class="sr-only" for="site-banner-search"><?php echo $escHtml($translate('Search the collection')); ?></label>
                <input class="site-banner__search-input" type="search" id="site-banner-search"
                    name="<?php echo $escAttr($searchParam); ?>"
                    placeholder="<?php echo $escAttr($translate('Search records, people, places, subjects…')); ?>">
                <button class="site-banner__search-submit" type="submit"><?php echo $escHtml($translate('Search')); ?></button>
            </form>
            <?php if ($stats): ?>
                <p class="site-banner__search-note"><?php echo $escHtml($translate('Or browse a corpus below — each has its own filters.')); ?></p>
            <?php endif; ?>
        <?php endif; ?>

        <?php if ($buttonLink): ?>
            <p class="site-banner__cta-row">
                <a class="button site-banner__cta" href="<?php echo $escAttr($buttonLink); ?>">
                    <?php echo $escHtml($buttonLabel ?: $translate('Explore the collection')); ?>
                    <svg class="site-banner__cta-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </p>
        <?php endif; ?>
    </div>

    <?php // Corpus counts — a hairline strip, not eleven bordered cards. The
          // hairlines are the grid's 1px gaps (see _banner.scss), so they never
          // dangle whatever the set size or wrap. Each cell links to its
          // authority page; Resource Types has none and stays a <div>. ?>
    <?php if ($stats):
        $statLinks = [
            'researchItems' => 'research-items',
            'projects'      => 'research-projects',
            'people'        => 'people',
            'organisations' => 'organisations',
            'locations'     => 'locations',
            'languages'     => 'languages',
            'subjectsTags'  => 'subjects-tags',
            'publications'  => 'publications',
            'podcasts'      => 'podcasts',
            'youtube'       => 'youtube-videos',
        ];
        $siteBase = $site ? rtrim((string) $site->url(), '/') : '';
    ?>
    <div class="site-banner__stats">
        <div class="container site-banner__stats-grid">
            <?php foreach ($stats as $s):
                $slug = (!empty($s['k']) && !empty($statLinks[$s['k']])) ? $statLinks[$s['k']] : null;
                $href = ($slug && $siteBase !== '') ? $siteBase . '/page/' . $slug : null;
                $tag  = $href ? 'a' : 'div';
            ?>
                <<?php echo $tag; ?> class="site-banner__stat"<?php echo $href ? ' href="' . $escAttr($href) . '"' : ''; ?>>
                    <span class="site-banner__stat-num"><?php echo $escHtml($formatNumber($s['n'])); ?><?php if (!empty($s['s'])): ?> <span class="site-banner__stat-sub"><?php echo $escHtml($s['s']); ?></span><?php endif; ?></span>
                    <span class="site-banner__stat-label"><?php echo $escHtml($s['l']); ?></span>
                </<?php echo $tag; ?>>
            <?php endforeach; ?>
        </div>
    </div>
    <?php endif; ?>

    <?php else: ?>
    <?php // Interior: a slim strip. The title is a <p>, never a second <h1> —
          // the page's own title owns that. ?>
    <div class="container site-banner__inner">
        <div class="site-banner__flag" aria-hidden="true"></div>
        <p class="site-banner__title"><?php echo $escHtml($heading); ?></p>
    </div>
    <?php endif; ?>
</div>
