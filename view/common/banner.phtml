<?php
/**
 * Site banner — an earth-tone colour wash.
 *
 * A photography-free masthead: a soft diagonal sweep through the brand's earth
 * tones (Uni-Grün → Gold → Braun), drawn purely in CSS (see the component
 * stylesheet). It needs no image and is theme-aware — a pale wash under dark
 * type in light mode, a deep wash under light type in dark mode.
 *
 *  • Home  → a tall hero that carries the site title as the page <h1>.
 *  • Other → a slim masthead that keeps the title visible across the site.
 *
 * Copy is overridable from the theme's "Banner" settings; with nothing set it
 * falls back to the site title so the banner is meaningful out of the box.
 */

$escHtml   = $this->plugin('escapeHtml');
$escAttr   = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$isHome = isset($isHome) ? (bool) $isHome : false;
$site   = isset($site) ? $site : $this->currentSite();

// Interior pages can opt out of the masthead (default on for fresh installs).
$showInterior = !in_array((string) $this->themeSetting('banner_show_interior', '1'), ['0', ''], true);
if (!$isHome && !$showInterior) {
    return;
}

$siteTitle = $site ? $site->title() : '';
$heading   = $this->themeSetting('banner_heading') ?: $siteTitle;
if ($heading === '' || $heading === null) {
    return; // nothing to show, no point rendering an empty band
}

$eyebrow = $this->themeSetting('banner_eyebrow');
if ($eyebrow === null) {
    $eyebrow = $translate('Digital Research Environment');
}
$tagline     = $this->themeSetting('banner_description');
$buttonLabel = $this->themeSetting('banner_button_label');
$buttonLink  = $this->themeSetting('banner_button_link');
// Default the hero CTA to the federated search (DRE-Search module's /dre-search
// route) so "Explore the collection" is present out of the box; an admin can
// repoint or clear it via the Banner settings. Resolved from the site URL so it
// is correct on every site/host.
if (($buttonLink === null || $buttonLink === '') && $site) {
    $buttonLink = rtrim((string) $site->url(), '/') . '/dre-search';
}

$variant = $isHome ? 'home' : 'page';

// Home-only "Collection overview" stat band (§1). The cards mirror the SAME set
// the ResourceVisualizations "Collection Overview" block shows — read from its
// precompute server-side (with an Omeka-API fallback for a module-less host) and
// cached briefly so the home page doesn't recompute on every load. The block
// itself drops its stat cards on the home layout, so this band is the single
// place they appear. Toggle via a theme setting; any hiccup falls back to no
// band — the hero still renders.
$stats = [];
$showStats = $isHome
    && !in_array((string) $this->themeSetting('banner_show_stats', '1'), ['0', ''], true);
if ($showStats) {
    $siteId = $site ? $site->id() : null;

    // Counts are cached in Omeka's DB-backed settings, not a per-container /tmp
    // file. The org runs several containerised Omeka instances, so a filesystem
    // cache in sys_get_temp_dir() meant each node recomputed and they could
    // disagree, and an ephemeral tmpfs dropped the cache on every deploy. A
    // setting is shared by every container and survives deploys. The key carries
    // a schema version (v3) so a change to the metric set ignores a stale cache
    // of the old shape (the value is {t: <unix-time>, nums: {...}}). Reaching the
    // settings service is wrapped in catch(\Throwable) so nothing about it — an
    // unavailable service, a deprecation-as-exception dev config, even an
    // undefined-method Error — can take the home page down: it just recomputes
    // without caching.
    $settings = null;
    try {
        $settings = $this->getHelperPluginManager()->getServiceLocator()->get('Omeka\Settings');
    } catch (\Throwable $e) {
        $settings = null;
    }
    // v4: cache the RENDERED stat list (now sourced from the module precompute),
    // each entry {k:key, l:label, n:value, s:subtitle}; the bumped key ignores the
    // old v3 shape ({nums: …}).
    $cacheKey = 'dre_stats_v4_' . ($siteId ?: 'x');

    $stats = null;
    if ($settings) {
        try {
            $cached = json_decode((string) $settings->get($cacheKey, ''), true);
            if (is_array($cached) && isset($cached['t'], $cached['stats']) && is_array($cached['stats'])
                && (time() - (int) $cached['t']) < 3600
            ) {
                $stats = $cached['stats'];
            }
        } catch (\Throwable $e) {
            $stats = null;
        }
    }
    if (!is_array($stats)) {
        // 1. Prefer the SAME stat set the "Collection Overview" block shows: read
        //    its precompute (collection-overview.json `stats`) off the filesystem,
        //    so the home band and that block never disagree and the band is the
        //    one place those cards live. Each entry is {key,label,value,subtitle?}.
        //    Fully guarded — a missing module / file / malformed JSON falls through
        //    to the API fallback.
        try {
            if (defined('OMEKA_PATH')) {
                $ovPath = OMEKA_PATH . '/modules/DreVisualizations/asset/data/item-dashboards/collection-overview.json';
                if (is_readable($ovPath)) {
                    $ov = json_decode((string) file_get_contents($ovPath), true);
                    if (is_array($ov) && !empty($ov['stats']) && is_array($ov['stats'])) {
                        $built = [];
                        foreach ($ov['stats'] as $st) {
                            if (!is_array($st) || !isset($st['label'], $st['value'])) {
                                continue;
                            }
                            $built[] = [
                                'k' => (string) ($st['key'] ?? ''),
                                'l' => (string) $st['label'],
                                'n' => (int) $st['value'],
                                's' => isset($st['subtitle']) ? (string) $st['subtitle'] : '',
                            ];
                        }
                        if (count($built) >= 3) {
                            $stats = $built;
                        }
                    }
                }
            }
        } catch (\Throwable $e) {
            $stats = null;
        }

        // 2. Fallback — no module / un-regenerated precompute: the theme's own
        //    API-computed counts (a smaller set, no subtitles), so a standalone
        //    DRE theme still grounds the hero. 'k' selects the Lucide glyph below.
        if (!is_array($stats)) {
            try {
                $api = $this->api();
                // Resolve template + item-set labels to ids (fetched with limit > 0);
                // the item counts below use limit=0 + getTotalResults() — count only.
                $tplId = [];
                foreach ($api->search('resource_templates', ['limit' => 1000])->getContent() as $t) {
                    $tplId[$t->label()] = $t->id();
                }
                $setId = [];
                foreach ($api->search('item_sets', ['limit' => 1000])->getContent() as $s) {
                    $title = (string) $s->displayTitle();
                    if ($title !== '') {
                        $setId[$title] = $s->id();
                    }
                }
                $total = function (array $query) use ($api, $siteId) {
                    if ($siteId) {
                        $query['site_id'] = $siteId;
                    }
                    $query['limit'] = 0;
                    return (int) $api->search('items', $query)->getTotalResults();
                };
                $byTemplate = function ($label) use ($tplId, $total) {
                    return isset($tplId[$label]) ? $total(['resource_template_id' => $tplId[$label]]) : 0;
                };
                $bySet = function ($label) use ($setId, $total) {
                    return isset($setId[$label]) ? $total(['item_set_id' => $setId[$label]]) : 0;
                };
                // "Publications" is the sum of the bibliographic templates.
                $publications = 0;
                foreach (['Article', 'Working paper', 'Conference paper', 'Book chapter',
                          'Book', 'Doctoral thesis', 'Journal issue', 'Book review',
                          'Online post'] as $pubLabel) {
                    $publications += $byTemplate($pubLabel);
                }
                $stats = [
                    ['k' => 'researchItems', 'l' => $translate('Research items'),  'n' => $byTemplate('Research Items'), 's' => ''],
                    ['k' => 'projects',      'l' => $translate('Projects'),        'n' => $byTemplate('Projects'),       's' => ''],
                    ['k' => 'publications',  'l' => $translate('Publications'),     'n' => $publications,                 's' => ''],
                    ['k' => 'people',        'l' => $translate('People'),          'n' => $byTemplate('Persons'),        's' => ''],
                    ['k' => 'organisations', 'l' => $translate('Organisations'),   'n' => $byTemplate('Organisation'),   's' => ''],
                    ['k' => 'locations',     'l' => $translate('Locations'),       'n' => $byTemplate('Location'),       's' => ''],
                    ['k' => 'subjectsTags',  'l' => $translate('Subjects & tags'), 'n' => $bySet('Subjects'),            's' => ''],
                    ['k' => 'resourceTypes', 'l' => $translate('Resource types'),  'n' => $bySet('Type of Resource'),    's' => ''],
                ];
            } catch (\Throwable $e) {
                $stats = null;
            }
        }

        if ($settings && is_array($stats)) {
            $settings->set($cacheKey, json_encode(['t' => time(), 'stats' => $stats]));
        }
    }
    if (!is_array($stats)) {
        $stats = [];
    }
}
?>
<div class="site-banner site-banner--<?php echo $variant; ?>">
    <?php // Decorative earth-tone wash (green → gold → braun); styled in CSS. ?>
    <div class="site-banner__art" aria-hidden="true"></div>

    <div class="container site-banner__inner">
        <div class="site-banner__content">
            <?php if ($isHome && $eyebrow): ?>
                <p class="site-banner__eyebrow"><?php echo $escHtml($eyebrow); ?></p>
            <?php endif; ?>

            <?php if ($isHome): ?>
                <h1 class="site-banner__title"><?php echo $escHtml($heading); ?></h1>
            <?php else: ?>
                <p class="site-banner__title"><?php echo $escHtml($heading); ?></p>
            <?php endif; ?>

            <?php if ($isHome && $tagline): ?>
                <p class="site-banner__tagline"><?php echo nl2br($escHtml($tagline)); ?></p>
            <?php endif; ?>

            <?php if ($isHome && $buttonLink): ?>
                <a class="button site-banner__cta" href="<?php echo $escAttr($buttonLink); ?>">
                    <?php echo $escHtml($buttonLabel ?: $translate('Explore the collection')); ?>
                    <svg class="site-banner__cta-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            <?php endif; ?>
        </div>
    </div>

    <?php // Collection overview — a live stat-card grid grounding the hero (§1).
          // Sits over the wash on its own surface, set off by the Uni-Grün rule.
          // Each card mirrors ResourceVisualizations' .rv-stat-card (design-review
          // F2): label, value, and a Lucide icon badge. The glyphs are the same set
          // as the module's STAT_ICONS, inlined here because the banner is
          // server-rendered theme chrome (no dependency on the module's JS). ?>
    <?php if ($stats):
        $statIcons = [
            'researchItems' => '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
            'projects' => '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
            'publications' => '<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>',
            'people' => '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
            'organisations' => '<path d="M10 12h4"/><path d="M10 8h4"/><path d="M14 21v-3a2 2 0 0 0-4 0v3"/><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/>',
            'locations' => '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
            'subjectsTags' => '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
            'resourceTypes' => '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>',
            'languages' => '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
            'podcasts' => '<path d="M16.85 18.58a9 9 0 1 0-9.7 0"/><path d="M8 14a5 5 0 1 1 8 0"/><circle cx="12" cy="11" r="1"/><path d="M13 17a1 1 0 1 0-2 0l.5 4.5a.5.5 0 0 0 1 0Z"/>',
            'youtube' => '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
        ];
        // Generic fallback (lucide chart-column), mirroring the module's
        // DEFAULT_ICON, so a new/unmapped stat key still renders a badge.
        $statIconDefault = '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>';
        // Each card links to its authority / overview page on this site
        // (/s/<slug>/page/<page-slug>), built relative to the current site so it is
        // correct on every host. Resource Types has no page, so it is omitted here
        // and renders as a non-link card. Add a key to link a new stat card.
        $statLinks = [
            'researchItems' => 'research-items',
            'projects'      => 'research-projects',
            'people'        => 'people',
            'organisations' => 'organisations',
            'locations'     => 'locations',
            'languages'     => 'languages',
            'subjectsTags'  => 'subjects-tags',
            'publications'  => 'publications',
            'podcasts'      => 'podcasts',
            'youtube'       => 'youtube-videos',
        ];
        $siteBase = $site ? rtrim((string) $site->url(), '/') : '';
    ?>
    <div class="site-banner__stats">
        <div class="container site-banner__stats-grid">
            <?php foreach ($stats as $s):
                $icon = (!empty($s['k']) && isset($statIcons[$s['k']])) ? $statIcons[$s['k']] : $statIconDefault;
                $slug = (!empty($s['k']) && !empty($statLinks[$s['k']])) ? $statLinks[$s['k']] : null;
                $href = ($slug && $siteBase !== '') ? $siteBase . '/page/' . $slug : null;
                // A linked card is an <a>; a card without a page (Resource Types) stays a <div>.
                $tag  = $href ? 'a' : 'div';
            ?>
                <<?php echo $tag; ?> class="site-banner__stat"<?php echo $href ? ' href="' . $escAttr($href) . '"' : ''; ?>>
                    <div class="site-banner__stat-body">
                        <span class="site-banner__stat-label"><?php echo $escHtml($s['l']); ?></span>
                        <?php // The optional subtitle ("in 39 countries") sits INLINE after
                              // the value, not on a row below it, so a card with a subtitle
                              // stays the same height as the rest (grid would otherwise
                              // stretch its whole row, leaving blank space). Hidden on the
                              // dense phone tiles where it would wrap (see _banner.scss). ?>
                        <span class="site-banner__stat-num"><?php echo $escHtml(number_format((int) $s['n'])); ?><?php if (!empty($s['s'])): ?> <span class="site-banner__stat-sub"><?php echo $escHtml($s['s']); ?></span><?php endif; ?></span>
                    </div>
                    <span class="site-banner__stat-badge">
                        <svg class="site-banner__stat-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><?php echo $icon; ?></svg>
                    </span>
                </<?php echo $tag; ?>>
            <?php endforeach; ?>
        </div>
    </div>
    <?php endif; ?>
</div>
