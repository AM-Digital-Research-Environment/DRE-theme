	<?php // ===== Menu-flash fix (#06) — classify BEFORE first paint ===========
	      // Mirrors the theme FOUC pattern: at $xl+ measure the menu's one-line
	      // width against its (now full-width) row and set data-nav synchronously,
	      // so the desktop menu never paints then snaps to the drawer. Exposed as
	      // window.__dreClassifyNav so navigation.js reuses it on resize/fonts.
	      // No-JS: html lacks `.js`, the visibility gate is inert, the wrap falls back. ?>
	<script>
	(function () {
		var XL = 1200;
		var header = document.querySelector('.main-header');
		var container = header && header.querySelector('.main-navigation__container');
		var menu = container && container.querySelector('ul');
		if (!header || !container || !menu) return;

		function naturalWidth() {
			var pc = container.style.cssText, pm = menu.style.cssText;
			container.style.cssText = 'display:block;position:absolute;visibility:hidden;left:-9999px;top:0;width:max-content';
			menu.style.cssText = 'flex-wrap:nowrap;width:max-content';
			var w = menu.getBoundingClientRect().width;
			container.style.cssText = pc; menu.style.cssText = pm;
			return w;
		}

		function classify() {
			if (window.innerWidth < XL) { header.removeAttribute('data-nav'); return; }
			// The nav owns a full-width row, so the envelope is the row itself.
			var avail = container.clientWidth || header.clientWidth;
			var need = naturalWidth() + 8;
			header.setAttribute('data-nav', need > avail ? 'drawer' : 'inline');
		}

		window.__dreClassifyNav = classify;
		classify();
	})();
	</script>

