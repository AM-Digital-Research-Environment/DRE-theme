<?php
$translate = $this->plugin('translate');
$navDepth = (int) $this->themeSetting('nav_depth') ? (int) $this->themeSetting('nav_depth') - 1 : -1;
$logo = $this->themeSetting('logo');
$isHome = isset($isHome) ? (bool) $isHome : false;
// On the home page the hero banner carries the site title as the page <h1>, so
// the header lockup steps down to a plain home link to avoid two competing h1s.
$titleTag = $isHome ? 'div' : 'h1';
?>

<header class="main-header">

	<?php echo $userBar; ?>

	<?php echo $this->partial('common/top-header'); ?>

	<div class="main-header__main-bar container">
		<<?php echo $titleTag; ?> class="main-header__site-title site-title">
			<a href="<?php echo $site->url(); ?>" rel="home">
			<?php if ($logo): ?>
				<img class="site-logo site-logo--custom" src="<?php echo $this->themeSettingAssetUrl('logo'); ?>" alt="<?php echo $this->escapeHtmlAttr($site->title()); ?>" />
			<?php else: ?>
				<?php // Bundled Africa Multiple lockup. Two variants swap on [data-theme]
				      // so the grey "multiple" wordmark stays legible on the forest-dark
				      // surface. A visually-hidden site title preserves the heading text. ?>
				<span class="sr-only"><?php echo $this->escapeHtml($site->title()); ?></span>
				<img class="site-logo site-logo--light" src="<?php echo $this->assetUrl('img/africamultiple.webp'); ?>"
					alt="<?php echo $this->escapeHtmlAttr($translate('Africa Multiple Cluster of Excellence')); ?>"
					width="1200" height="295" fetchpriority="high" decoding="async" />
				<img class="site-logo site-logo--dark" src="<?php echo $this->assetUrl('img/africamultiple-dark.webp'); ?>"
					alt="" aria-hidden="true" width="1200" height="295" decoding="async" />
			<?php endif; ?>
			</a>
		</<?php echo $titleTag; ?>>

		<?php // Federated Typesense search (DRESearch module). Falls back to the
		      // core search form when the module is absent. Mobile: collapsible. ?>
		<?php if ($this->getHelperPluginManager()->has('dreSearchBar')): ?>
			<?php echo $this->dreSearchBar('header-mobile', 'd-block d-xl-none', true); ?>
		<?php else: ?>
			<?php echo $this->partial('common/main-header-search', ['class' => 'd-block d-xl-none', 'site' => $site]); ?>
		<?php endif; ?>

		<nav class="main-navigation" aria-label="<?php echo $this->escapeHtmlAttr($translate('Primary navigation')); ?>">
			<div class="main-navigation__container">
				<?php
				echo $site->publicNav()->menu()->renderMenu(null, [
					'addClassToListItem' => true,
					'maxDepth' => $navDepth
				]);
				?>
			</div>
			<button
				class="main-navigation__toggle"
				aria-expanded="false"
				aria-controls="menu-drawer"
			>
				<span class="sr-only"><?php echo $translate('Open menu'); ?></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</nav>

		<div class="main-header__utilities">
			<?php // Desktop: always-visible federated search input (see mobile note above). ?>
			<?php if ($this->getHelperPluginManager()->has('dreSearchBar')): ?>
				<?php echo $this->dreSearchBar('header-desktop', 'd-none d-xl-block', false); ?>
			<?php else: ?>
				<?php echo $this->partial('common/main-header-search', ['class' => 'd-none d-xl-block', 'site' => $site]); ?>
			<?php endif; ?>

			<?php // Both icons render; CSS reveals the active one based on body[data-theme],
			      // which the head-script sets before first paint (no flash of wrong icon). ?>
			<button class="theme-toggle" data-theme-toggle type="button"
				aria-label="<?php echo $this->escapeHtmlAttr($translate('Toggle dark mode')); ?>" aria-pressed="false">
				<span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
				<span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
			</button>
		</div>

		<?php echo $this->partial('common/menu-drawer'); ?>

	</div>

</header>
