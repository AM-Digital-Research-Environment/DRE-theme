	<?php // Resolve mode before paint; navigation.js reuses this on resize and font readiness. ?>
	<script>
	(function () {
		var XL = 1200;
		var header = document.querySelector('.main-header');
		var container = header && header.querySelector('.main-navigation__container');
		var menu = container && container.querySelector('ul');
		if (!header || !container || !menu) return;

		function naturalWidth() {
			var pc = container.style.cssText, pm = menu.style.cssText;
			container.style.cssText = 'display:block;position:absolute;visibility:hidden;left:-9999px;top:0;width:max-content';
			menu.style.cssText = 'display:flex;flex-wrap:nowrap;width:max-content';
			var w = menu.getBoundingClientRect().width;
			container.style.cssText = pc; menu.style.cssText = pm;
			return w;
		}

		function classify() {
			if (window.innerWidth < XL) { header.setAttribute('data-nav', 'drawer'); return; }
			// Measure the real inline rules even when arriving from drawer mode.
			// The successful-init gate is restored within this same task.
			var ready = header.classList.contains('nav-ready');
			header.classList.add('nav-ready');
			header.setAttribute('data-nav', 'inline');
			var avail = container.clientWidth || header.clientWidth;
			var need = naturalWidth() + 8;
			if (!ready) header.classList.remove('nav-ready');
			header.setAttribute('data-nav', need > avail ? 'drawer' : 'inline');
		}

		window.__dreClassifyNav = classify;
		classify();

		// navigation.js adds .nav-ready at DOMContentLoaded. Still missing at
		// load means it failed: fall back to the expanded list (_header.scss).
		window.addEventListener('load', function () {
			if (!header.classList.contains('nav-ready')) header.classList.add('nav-failed');
		});
	})();
	</script>

</header>
