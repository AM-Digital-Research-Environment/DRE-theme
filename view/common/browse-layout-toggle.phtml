<?php
/**
 * Grid / list toggle for browse surfaces.
 *
 * Renders nothing unless the "Layout for Browse Pages" theme setting is one of
 * the toggle variants. The active view is the pressed button; both stay enabled
 * (asset/js/browse.js keeps aria-pressed in sync), because disabling the button
 * a keyboard user just activated would drop their focus to <body>.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $layout  The array returned by the BrowseLayout() view helper.
 */

if (empty($layout['hasToggle'])) {
    return;
}

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$isGrid = !empty($layout['isGrid']);
?>
<div class="layout-toggle" role="group" aria-label="<?php echo $escapeAttr($translate('View as')); ?>">
    <button type="button" class="grid" aria-pressed="<?php echo $isGrid ? 'true' : 'false'; ?>"><?php echo $escape($translate('Grid')); ?></button>
    <span class="layout-toggle-separator" aria-hidden="true"></span>
    <button type="button" class="list" aria-pressed="<?php echo $isGrid ? 'false' : 'true'; ?>"><?php echo $escape($translate('List')); ?></button>
</div>
