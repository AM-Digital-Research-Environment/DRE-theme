<?php
// Group metadata without changing Omeka value/annotation rendering contracts.
//
// $recordChrome (a displayValues() option, default true) sets the heading
// level: h2 group titles on a record page. Blocks that embed a record's values
// under their own heading (item-with-metadata) pass false for h4 titles.

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$decoration = $this->themeSetting('image_decoration');

if ($this->status()->isSiteRequest()) {
    $labelInfo = $this->siteSetting('property_label_information');
    $showLocale = (bool) $this->siteSetting('show_locale_label', true);
    $filterLocale = $this->siteSetting('filter_locale_values');
    $lang = $this->lang();
    // Core's select: '' hides, 'collapsed' / 'expanded' show. Unset means
    // shown, as in core's own resource-values template. Both modes start
    // closed: the annotation is a floating popover, and an open one would sit
    // over the record on load (core casts the setting to bool, so it never
    // expands either).
    $annotationMode = $this->siteSetting('show_value_annotations');
    $showValueAnnotations = null === $annotationMode || '' !== (string) $annotationMode;
} else {
    $labelInfo = $this->setting('property_label_information');
    $showLocale = true;
    $filterLocale = false;
    $lang = null;
    $showValueAnnotations = true;
}
$recordChrome = $recordChrome ?? true;
$filterLocaleCallback = function ($value) use ($lang) {
    $valueLang = $value->lang();
    return $valueLang == '' || strcasecmp($valueLang, $lang) === 0;
};

$this->inlineScript()->appendFile($this->assetUrl('js/annotations.js'));
$groups = [];
$prefix = $this->SectionPrefix(isset($resource) ? $resource->id() : 0);
foreach ($this->ResourceGroups($values) as $group) {
    $rendered = [];
    foreach ($group['values'] as $term => $propertyData) {
        $propertyValues = $filterLocale ? array_filter($propertyData['values'], $filterLocaleCallback) : $propertyData['values'];
        if ($propertyValues) $rendered[$term] = [$propertyData, $propertyValues];
    }
    if ($rendered) $groups[] = $group + ['rendered' => $rendered, 'id' => $prefix . '-' . $group['key']];
}
$headingTag = $recordChrome ? 'h2' : 'h4';
?>
<div class="record">
<?php foreach ($groups as $group):
    $rendered = $group['rendered'];
    // In the prose and chip groups the section heading already names the
    // property ("Abstract", "Subjects"), so the <dt> would repeat it. Keep it in
    // the DOM for assistive technology and hide it visually — unless the group
    // holds more than one property, where the labels do distinguish.
    $hideLabels = in_array($group['layout'], ['prose', 'chips'], true) && count($rendered) === 1;
    ?>
    <section id="<?php echo $escapeAttr($group['id']); ?>" class="record__group record__group--<?php echo $escapeAttr($group['layout']); ?>" data-group="<?php echo $escapeAttr($group['key']); ?>">
        <<?php echo $headingTag; ?> class="record__group-title"><?php echo $escape($group['title']); ?></<?php echo $headingTag; ?>>

        <dl class="record__list">
        <?php foreach ($rendered as $term => [$propertyData, $propertyValues]):
            $property = $propertyData['property'];
            $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());
            if ('term' === $labelInfo) {
                $propertyTerm = $property->term();
            } elseif ('vocab' === $labelInfo) {
                $propertyTerm = $property->vocabulary()->label();
            } else {
                $propertyTerm = null;
            }
            ?>
            <div class="property <?php echo $escapeAttr(str_replace(':', '-', $term)); ?>">
                <dt<?php echo $hideLabels ? ' class="sr-only"' : ''; ?>>
                <?php echo $escape($propertyLabel); ?>
                <?php if ($propertyTerm !== null) : ?>
                <span class="field-term">(<?php echo $escape($propertyTerm); ?>)</span>
                <?php endif; ?>
                </dt>
                <?php foreach ($propertyValues as $value): ?>
                    <?php
                    $valueType = $value->type();
                    $valueLang = $value->lang();
                    $valueAnnotation = $value->valueAnnotation();
                    $class = ['value'];
                    $isResource = ('resource' == $valueType || strpos($valueType, 'resource') !== false);
                    if ($isResource) {
                        $class[] = 'resource';
                        if ($value->valueResource()) $class[] = $value->valueResource()->resourceName();
                    } elseif ('uri' == $valueType) {
                        $class[] = 'uri';
                    }
                    ?>
                    <dd class="<?php echo $escapeAttr(implode(' ', $class)); ?>" lang="<?php echo $escapeAttr($valueLang); ?>">
                        <?php if ($showLocale && $valueLang) : ?>
                            <span class="language"><?php echo $escape($valueLang); ?></span>
                        <?php endif; ?>
                        <span class="value-content"><?php
                            // Resource values: render the link ourselves with an aspect-
                            // preserving ('medium') thumbnail. The core resource data type
                            // hard-codes linkPretty('square'), which centre-crops wide
                            // logos/wordmarks to a square; 'medium' keeps the full image.
                            // (_metadata.scss caps the height and frees the width.)
                            // Everything else still goes through asHtml() unchanged.
                            if ($isResource && $value->valueResource()):
                                echo $value->valueResource()->linkPretty('medium', null, null, null, $filterLocale ? $lang : []);
                            else:
                                echo $filterLocale ? $value->asHtml($lang) : $value->asHtml();
                            endif;
                        ?></span>
                        <?php if(!$value->isPublic()) : ?>
<?php // role="img" + aria-label so the icon has an accessible name. The attribute
      // here was `aria-role`, which is not a real attribute and did nothing. ?>
                            <span class="o-icon-private" role="img" title="<?php echo $this->escapeHtmlAttr($translate('Private')); ?>" aria-label="<?php echo $this->escapeHtmlAttr($translate('Private')); ?>"></span>
                        <?php endif; ?>
                        <?php if ($valueAnnotation && $showValueAnnotations) : ?>
                            <?php echo $this->partial('common/value-annotation', ['valueAnnotation' => $valueAnnotation]); ?>
                        <?php endif; ?>
                        <?php $this->trigger('view.show.value', ['value' => $value]); ?>
                    </dd>
                <?php endforeach; ?>
            </div>
        <?php endforeach; ?>
        </dl>
    </section>
<?php endforeach; ?>
</div>
