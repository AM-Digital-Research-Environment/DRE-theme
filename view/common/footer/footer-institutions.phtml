<?php
// Institutional marks — the host university and the cluster it belongs to.
// Shown on light plaques so the full-colour marks stay legible on the forest
// footer band in both light and dark mode. Rendered inside the masthead's
// right-hand column (the wrapping .main-footer__institutions lives there), so
// this partial emits only the grid. Each mark links out to its home page.
$escAttr   = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$institutions = [
    [
        'file' => 'bayreuth.webp',
        'name' => 'University of Bayreuth',
        'url'  => 'https://www.uni-bayreuth.de/en',
    ],
    [
        'file' => 'uni-bayreuth-africa-multiple-logo.webp',
        'name' => 'Africa Multiple Cluster of Excellence',
        'url'  => 'https://www.africamultiple.uni-bayreuth.de/en',
    ],
];
?>

<ul class="main-footer__institution-grid">
    <?php foreach ($institutions as $org): ?>
        <li class="main-footer__institution">
            <a href="<?php echo $escAttr($org['url']); ?>"
                target="_blank" rel="noopener noreferrer"
                aria-label="<?php echo $escAttr($translate($org['name'])); ?>">
                <img src="<?php echo $this->assetUrl('img/' . $org['file']); ?>"
                    alt="<?php echo $escAttr($translate($org['name'])); ?>"
                    loading="lazy" decoding="async" />
            </a>
        </li>
    <?php endforeach; ?>
</ul>
