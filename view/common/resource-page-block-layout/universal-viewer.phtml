<?php
/**
 * Theme override of the UniversalViewer module's resource-page block partial.
 *
 * Module default (UniversalViewer/view/common/resource-page-block-layout/universal-viewer.phtml):
 *
 *     <div class="block resource-block block-universal-viewer">
 *         <?= $this->universalViewer($resource) ?>
 *     </div>
 *
 * Universal Viewer renders an item's media from its IIIF manifest, but an
 * external *embed* (YouTube, oEmbed, raw HTML) is not a IIIF canvas, so the
 * generated manifest has zero canvases and UV reports "Unable to load
 * manifest". The amira site uses the UniversalViewer block as its item-page
 * media region, so for embed-bearing items we render the media's own native
 * player (e.g. the YouTube iframe) instead. Image / AV-file items fall through
 * to Universal Viewer unchanged, keeping IIIF deep-zoom.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 */

// Ingesters whose media are external embeds rather than IIIF-renderable files.
$embedIngesters = ['youtube', 'oembed', 'html'];

$embedMedia = [];
if (method_exists($resource, 'media')) {
    foreach ($resource->media() as $media) {
        if (in_array($media->ingester(), $embedIngesters, true)) {
            $embedMedia[] = $media;
        }
    }
}
?>
<?php if ($embedMedia): ?>
<div class="block resource-block block-universal-viewer block-media-embed">
    <?php foreach ($embedMedia as $media): ?>
        <?php $altText = $media->altText() ?: $media->displayTitle() ?: ''; ?>
        <div class="media-embed media-embed--video">
            <?= $media->render(['thumbnailAttribs' => ['alt' => $altText]]) ?>
        </div>
    <?php endforeach; ?>
</div>
<?php else: ?>
<div class="block resource-block block-universal-viewer">
    <?= $this->universalViewer($resource) ?>
</div>
<?php endif; ?>
