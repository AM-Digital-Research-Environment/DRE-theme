<?php
$escape = $this->plugin('escapeHtml');
$resourceMedia = $resource->media();
?>
<?php if ($resourceMedia): ?>
<dl class="media-list">
    <div class="property">
        <dt><?php echo $this->escapeHtml($this->translate('Media')); ?></dt>
        <?php foreach ($resourceMedia as $media): ?>
            <?php
            // The link already reads the media's title: an alt text of the
            // title too made a screen reader say it twice. A described
            // picture keeps its description; otherwise the image is silent.
            $altText = $this->ValueReader()->altText($media);
            $thumbnail = $this->thumbnail($media, 'square', ['alt' => $altText]);
            $linkContent = sprintf('%s<span class="resource-name">%s</span>',
                $thumbnail,
                $escape($media->displayTitle())
            );
            ?>
            <dd class="value">
                <?php echo $media->linkRaw($linkContent, null, ['class' => 'resource-link']); ?>
            </dd>
        <?php endforeach; ?>
    </div>
</dl>
<?php endif; ?>
