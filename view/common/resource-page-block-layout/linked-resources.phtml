<?php
// Render the initial page on the server: filtering and pagination work without JS.
try {
    $data = $this->ConnectionPage($resource, $this->params()->fromQuery());
} catch (\Throwable $e) {
    $this->IntegrationWarning($resource, 'connections', $e);
    echo '<p id="linked-resources" role="status">' . $this->escapeHtml($this->translate('Connections could not be loaded.')) . ' '
        . '<a href="' . $this->escapeHtmlAttr($resource->url()) . '#linked-resources">' . $this->escapeHtml($this->translate('Reload page')) . '</a></p>';
    return;
}
if (array_filter($data['resourcePropertiesAll'])):
    $endpoint = $this->url('site/resource-id', ['controller' => 'index', 'action' => 'linked-resources', 'id' => $resource->id()], [], true);
    $this->inlineScript()->appendFile($this->assetUrl('js/linked-resources.js'));
?>
<div id="linked-resources-container" data-connection-endpoint="<?php echo $this->escapeHtmlAttr($endpoint); ?>"
    data-loading="<?php echo $this->escapeHtmlAttr($this->translate('Loading connections…')); ?>"
    data-failed="<?php echo $this->escapeHtmlAttr($this->translate('Connections could not be loaded. Your previous results are still shown.')); ?>">
    <p data-connection-status role="status" aria-live="polite"></p>
    <div data-connection-recovery hidden>
        <button type="button" class="btn--secondary" data-connection-retry><?php echo $this->translate('Try again'); ?></button>
        <a data-connection-continue href="<?php echo $this->escapeHtmlAttr($resource->url()); ?>#linked-resources"><?php echo $this->translate('Open results as a page'); ?></a>
    </div>
    <?php echo $this->partial('common/linked-resources', $data); ?>
</div>
<?php endif; ?>
