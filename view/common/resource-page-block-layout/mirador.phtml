<?php
// External embeds and IIIF files can coexist on the same record.
$viewerLabel = $this->translate('Image viewer');
$embeds = [];
$viewerMedia = [];
$allMedia = method_exists($resource, 'media') ? $resource->media() : [];
foreach ($allMedia as $media) {
    if (in_array($media->ingester(), ['youtube', 'oembed', 'html'], true)) $embeds[] = $media;
    else $viewerMedia[] = $media;
}
?>
<?php if ($embeds): ?>
<div class="block resource-block block-mirador block-media-embed">
    <?php foreach ($embeds as $media): ?>
    <div class="media-embed media-embed--video">
        <?php try {
            echo $media->render(['thumbnailAttribs' => ['alt' => $media->altText() ?: $media->displayTitle() ?: '']]);
        } catch (\Throwable $e) {
            $this->IntegrationWarning($media, 'embed', $e);
            echo '<p>' . $this->escapeHtml($this->translate('Media is unavailable.')) . '</p>';
        } ?>
        <p><?php echo $media->link($this->translate('Open media record')); ?></p>
    </div>
    <?php endforeach; ?>
</div>
<?php endif; ?>
<?php
// Mirador owns manifest discovery and supported media checks. In particular,
// remote manifests and item-set collections need no attached local media.
$viewer = '';
try {
    $viewer = trim((string) $this->mirador($resource));
} catch (\Throwable $e) {
    $this->IntegrationWarning($resource, 'mirador', $e);
    echo '<p role="status">' . $this->escapeHtml($this->translate('The viewer is unavailable. Please try reloading the page.')) . '</p>';
}
if ($viewer !== ''):
    $this->headScript()->appendFile($this->assetUrl('js/mirador-theme.js'), 'text/javascript', ['defer' => 'defer']);
?>
<div class="block resource-block block-mirador" role="application" aria-label="<?php echo $this->escapeHtmlAttr($viewerLabel); ?>">
    <?php echo $viewer; ?>
</div>
<?php endif; ?>
<?php if ($viewerMedia): ?>
<details class="viewer-media-links"><summary><?php echo $this->translate('Media records'); ?></summary>
    <ul><?php foreach ($viewerMedia as $media): ?><li><?php echo $media->link($media->displayTitle()); ?></li><?php endforeach; ?></ul>
</details>
<?php endif; ?>
