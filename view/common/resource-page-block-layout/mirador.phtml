<?php
/**
 * Theme override of the Mirador module's resource-page block partial.
 *
 * Module default (Mirador/view/common/resource-page-block-layout/mirador.phtml):
 *
 *     <div class="block resource-block block-mirador">
 *         <?= $this->mirador($resource) ?>
 *     </div>
 *
 * Mirador renders an item's media from its IIIF manifest, but an external
 * *embed* (YouTube, oEmbed, raw HTML) is not a IIIF canvas, so the generated
 * manifest has zero canvases and the viewer has nothing to show. The amira site
 * uses the Mirador block as its item-page media region, so for embed-bearing
 * items we render the media's own native player (e.g. the YouTube iframe)
 * instead. Image / AV-file items fall through to Mirador unchanged, keeping IIIF
 * deep-zoom.
 *
 * Ported from the former universal-viewer.phtml override when the site moved
 * from Universal Viewer to Mirador: the IIIF-vs-embed split is identical — only
 * the fallback viewer changed. (Mirador cannot play a YouTube/oEmbed media for
 * the same reason UV could not: it is not a IIIF canvas.)
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 */

// Ingesters whose media are external embeds rather than IIIF-renderable files.
$embedIngesters = ['youtube', 'oembed', 'html'];

$embedMedia = [];
if (method_exists($resource, 'media')) {
    foreach ($resource->media() as $media) {
        if (in_array($media->ingester(), $embedIngesters, true)) {
            $embedMedia[] = $media;
        }
    }
}
?>
<?php if ($embedMedia): ?>
<div class="block resource-block block-mirador block-media-embed">
    <?php foreach ($embedMedia as $media): ?>
        <?php $altText = $media->altText() ?: $media->displayTitle() ?: ''; ?>
        <div class="media-embed media-embed--video">
            <?= $media->render(['thumbnailAttribs' => ['alt' => $altText]]) ?>
        </div>
    <?php endforeach; ?>
</div>
<?php else: ?>
<?php
// Make the IIIF viewer follow the site's light/dark toggle. Loaded only on
// pages that actually render Mirador; see asset/js/mirador-theme.js.
$this->headScript()->appendFile(
    $this->assetUrl('js/mirador-theme.js'),
    'text/javascript',
    ['defer' => 'defer']
);
?>
<div class="block resource-block block-mirador">
    <?= $this->mirador($resource) ?>
</div>
<?php endif; ?>
