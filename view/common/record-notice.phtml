<?php
/**
 * Record notice — the plain statement under the title (issue #10).
 *
 * On a research record: this page is a description, and the material is
 * elsewhere. Who to ask sits in the rail's "Access to this material", one glance
 * to the right (or just below the record on a phone), so the notice carries no
 * link of its own. On a project: the standard statement — whose metadata this
 * is, who answers for its accuracy, who to contact — so the DRE can point to it
 * instead of taking a collection offline.
 *
 * Written for a visitor who has never heard of metadata. Self-suppressing:
 * RecordAccess returns [] for everything that is not a research record or a
 * project, and for every record when the theme setting is off.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $access From RecordAccess, passed by item/show.phtml.
 */
if (empty($access)) return;

$escHtml = $this->plugin('escapeHtml');
$escAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');
$translatePlural = $this->plugin('translatePlural');

$linkList = function (array $links) use ($escHtml, $escAttr): string {
    $parts = [];
    foreach ($links as $link) {
        $parts[] = $link['href'] !== ''
            ? '<a href="' . $escAttr($link['href']) . '">' . $escHtml($link['label']) . '</a>'
            : $escHtml($link['label']);
    }
    return implode('; ', $parts);
};
$mailLink = '<a href="mailto:' . $escAttr($access['email']) . '">' . $escHtml($access['email']) . '</a>';
$leadId = 'record-notice-' . (int) $access['id'];
?>
<?php // A note on the record, not complementary content: as an aside it was a second
      // "complementary" landmark beside the rail, and an unlabelled one. ?>
<div class="record-notice" role="note" aria-labelledby="<?php echo $escAttr($leadId); ?>">
<?php if ($access['kind'] === 'record'): ?>
    <p>
        <strong class="record-notice__lead" id="<?php echo $escAttr($leadId); ?>"><?php echo $escHtml($translate('This page is a catalogue record.')); ?></strong>
        <?php // "From" rather than "research project": ILAM and BayGlo are external collections. ?>
        <?php if ($access['hasMedia']): ?>
            <?php // Some records carry the whole document (Museu Afro-Digital's postcards), others a
                  // label or a frame grab (ILAM, ELTV): never claim the page has nothing, nor everything. ?>
            <?php echo sprintf($escHtml($translate('It comes from %s. The original material is kept elsewhere: the images or files shown here are copies for reference and may show only part of it.')), $linkList($access['projects'])); ?>
        <?php else: ?>
            <?php echo sprintf($escHtml($translate('It comes from %s and describes material kept elsewhere: AMIRA holds only this description and cannot supply the material itself.')), $linkList($access['projects'])); ?>
        <?php endif; ?>
    </p>
<?php else: ?>
    <?php
    $context = implode(', ', array_filter([
        implode(', ', array_column($access['sections'], 'label')),
        $access['years'],
    ]));
    $title = '<em>' . $escHtml($access['title']) . '</em>' . ($context !== '' ? ' (' . $escHtml($context) . ')' : '');
    ?>
    <p>
        <strong class="record-notice__lead" id="<?php echo $escAttr($leadId); ?>"><?php echo $escHtml($translate('About these records.')); ?></strong>
        <?php if ($access['contactSource'] === 'dre'): ?>
            <?php echo sprintf($escHtml($translate('This page presents the metadata of the collection %s.')), $title); ?>
        <?php else: ?>
            <?php echo sprintf($escHtml($translate('This page presents the metadata produced by the research project %s.')), $title); ?>
            <?php echo $escHtml($translate('The project team described the material following the curation guidelines of the Digital Research Environment (DRE); the researchers are responsible for the accuracy of the descriptions.')); ?>
        <?php endif; ?>
        <?php echo $escHtml($translate('AMIRA does not hold the material itself.')); ?>
        <?php if (!empty($access['records'])): ?>
            <?php // The records themselves: the project's item set, one click from its statement. ?>
            <a href="<?php echo $escAttr($access['records']['href']); ?>"><?php echo sprintf(
                $escHtml($translatePlural('Browse the %1$s record of %2$s', 'Browse the %1$s records of %2$s', $access['records']['count'])),
                $escHtml(number_format($access['records']['count'])),
                '<em>' . $escHtml($access['title']) . '</em>'
            ); ?></a>.
        <?php endif; ?>
    </p>
    <p>
        <?php if ($access['contactSource'] === 'team' && $access['pis']): ?>
            <?php echo sprintf(
                $escHtml($translatePlural('For access or more information, contact the principal investigator, %1$s, or the project’s researchers; if you cannot reach them, write to the DRE at %2$s.', 'For access or more information, contact the principal investigators, %1$s, or the project’s researchers; if you cannot reach them, write to the DRE at %2$s.', count($access['pis']))),
                $linkList($access['pis']),
                $mailLink
            ); ?>
        <?php elseif ($access['contactSource'] === 'team'): ?>
            <?php echo sprintf($escHtml($translate('For access or more information, contact the project’s researchers, listed on this page; if you cannot reach them, write to the DRE at %s.')), $mailLink); ?>
        <?php elseif ($access['contactSource'] === 'mediator'): ?>
            <?php echo sprintf($escHtml($translate('For access or more information, contact %1$s; if you cannot reach them, write to the DRE at %2$s.')), $linkList($access['contacts']), $mailLink); ?>
        <?php else: ?>
            <?php echo sprintf($escHtml($translate('For access or more information, write to the DRE at %s.')), $mailLink); ?>
        <?php endif; ?>
        <?php if ($access['accessPageUrl'] !== ''): ?>
            <a href="<?php echo $escAttr($access['accessPageUrl']); ?>"><?php echo $escHtml($translate('More about access to AMIRA material')); ?></a>
        <?php endif; ?>
    </p>
<?php endif; ?>
</div>
