<?php
// Two-region desktop panels; nested lists retain every configured level.

$translate = $this->plugin('translate');
$escapeHtml = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');

// One framing sentence per section (keyed by the parent page slug).
// The `// @translate` markers let scripts/extract-translations.mjs pick these up
// for language/template.pot; they are passed through $translate() at the point
// of use below, so a translated site gets translated panel copy.
$introMap = [
    'research'       => "Projects, sections and the primary materials they produce.", // @translate
    'index'          => "The named entities that link every record together.", // @translate
    'public-outreach'=> "Public-facing media from the Cluster.", // @translate
    'visualisations' => "Read the metadata at a glance.", // @translate
    'collections'    => "Explore the Cluster's featured collections through timelines, image galleries and maps.", // @translate
];

// One short description per child (keyed by the child page slug).
$descMap = [
    // Research
    'research-sections' => "The Cluster's thematic areas", // @translate
    'research-projects' => "Projects across the AMRCs", // @translate
    'research-items'    => "Sources, media & datasets", // @translate
    // Index
    'people'        => "Authors & named persons", // @translate
    'organisations' => "Institutions & bodies", // @translate
    'genres'        => "Document & media types", // @translate
    'languages'     => "Languages represented", // @translate
    'locations'     => "Places & georeferences", // @translate
    'subjects-tags' => "Topics & keywords", // @translate
    // Outreach
    'podcasts'       => "Audio series", // @translate
    'youtube-videos' => "Talks & recordings", // @translate
    // Visualisations
    'project-explorer'           => "Browse projects interactively", // @translate
    'compare'                    => "Projects side by side", // @translate
    'spatial-exploration'        => "Places mapped & georeferenced", // @translate
    'publications-visualisations'=> "Publication trends & networks", // @translate
    'podcasts-visualisations'    => "Episode trends & transcripts", // @translate
    'networks'                   => "Knowledge-graph links", // @translate
    // Collections
    'international-library-of-african-music-ilam' => "Africa's foremost music archive", // @translate
    'memorias-perifericas-capoeira-angola-salvador' => "Peripheral memories of Capoeira Angola in Salvador", // @translate
    'orixas-fundacao-gregorio-de-mattos' => "Orishas — Gregório de Mattos Foundation", // @translate
    'trabalhadores-na-da-bahia'  => "Workers in/from Bahia", // @translate
];

// The last path segment of a page link's href is its slug
// (.../page/<slug>); used to look up the maps above.
$slugOf = function ($page) {
    $path = (string) parse_url((string) $page->getHref(), PHP_URL_PATH);
    return rtrim(basename($path), '/');
};

$container = $site->publicNav()->getContainer();
$topPages = $container->getPages();

// "Top Navigation Depth" theme setting, passed in by common/header.phtml.
// 0 means all levels; 1 suppresses the panels.
$navDepth = isset($navDepth) ? max(0, (int) $navDepth) : 0;
$showChildren = (0 === $navDepth || $navDepth >= 2);

// "View all" arrow + the parent caret share the theme's Lucide line style.
$arrowSvg = '<svg class="nav-panel__viewall-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
?>
<ul class="navigation">
    <?php foreach ($topPages as $page): ?>
        <?php
        if (!$page->isVisible()) {
            continue;
        }
        $hasPages  = $page->hasPages();
        $isActive  = $page->isActive(true);
        $label     = (string) $page->getLabel();
        $href      = (string) $page->getHref();
        $introRaw  = $hasPages ? ($introMap[$slugOf($page)] ?? null) : null;
        $intro     = $introRaw ? $translate($introRaw) : null;

        // Visible children only; the panel is a 3-column grid on desktop, so the
        // rail spans one grid row per (up to) three children. Suppressed entirely
        // when the depth setting limits the menu to one level.
        $children = [];
        if ($hasPages && $showChildren) {
            foreach ($page->getPages() as $child) {
                if ($child->isVisible()) {
                    $children[] = $child;
                }
            }
        }
        $railRows = max(1, (int) ceil(count($children) / 3));
        ?>
        <?php // Keyed off $children, not $hasPages: when the depth setting
              // suppresses the panel there is no submenu, so the class must not
              // be set — navigation.js injects its caret <button> on the strength
              // of it, and the CSS opens a panel that would not exist. ?>
        <li class="nav-item<?php echo $children ? ' menu-item-has-children' : ''; ?><?php echo $isActive ? ' active' : ''; ?>">
            <?php echo $this->partial('common/nav-link', ['page' => $page, 'class' => 'nav-item__link']); ?>

            <?php if ($children): ?>
            <ul class="nav-panel">
                <li class="nav-panel__rail" style="grid-row:1 / span <?php echo $railRows; ?>;">
                    <span class="nav-panel__title"><?php echo $escapeHtml($label); ?></span>
                    <?php if ($intro): ?>
                        <span class="nav-panel__intro"><?php echo $escapeHtml($intro); ?></span>
                    <?php endif; ?>
                    <a class="nav-panel__viewall" href="<?php echo $escapeAttr($href); ?>">
                        <?php echo $escapeHtml($translate('View all')); ?><?php echo $arrowSvg; ?>
                    </a>
                </li>
                <?php echo $this->partial('common/nav-children', ['pages' => $children, 'level' => 2, 'navDepth' => $navDepth, 'descMap' => $descMap]); ?>
            </ul>
            <?php endif; ?>
        </li>
    <?php endforeach; ?>
</ul>
