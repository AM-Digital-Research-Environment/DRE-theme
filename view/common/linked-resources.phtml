<?php
// Shared server-rendered connection page. Local facets/sorting refine this page;
// the GET form searches the entire bounded, authorized relationship result set.

$escape     = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$translate  = $this->plugin('translate');

// Locale (mirror the rest of the theme).
$valueLang = null;
if ($this->status()->isSiteRequest()) {
    $lang = $this->lang();
    $valueLang = (bool) $this->siteSetting('filter_locale_values') ? [$lang, ''] : null;
}
$headingTerm = $this->siteSetting('browse_heading_property_term');

// Pagination (only used when the linked set spans more than one page).
$fragment = 'linked-resources';
$isPaginated = $totalCount > $perPage;

// --- Merge the per-property groups into one list, keyed by connected record.
//     A record linked through several properties (e.g. author *and* editor)
//     appears once, carrying every relationship. Facet counts are per
//     relationship, so they may sum to more than the unique record count. ---
['connections' => $connections, 'facets' => $facets, 'ranked' => $ranked] = $this->LinkedConnections($subjectValues, $headingTerm, $valueLang);

$uniqueCount = count($connections);
// The summary noun follows the visible count; the facet filter swaps between
// the one/many forms client-side as the count changes.
$translatePlural = $this->plugin('translatePlural');
$summaryLabel = function (int $count) use ($translatePlural, $isPaginated): string {
    return $isPaginated
        ? $translatePlural('connection on this page', 'connections on this page', $count)
        : $translatePlural('connection to this record', 'connections to this record', $count);
};
$hasFacets   = count($facets) > 1;
$showSort    = $uniqueCount > 1;
$showControls = $hasFacets || $showSort;

// Resource-type switch (only when more than one type links here).
$typeLabels = [
    'items'     => $translate('Items'),
    'item_sets' => $translate('Item sets'),
    'media'     => $translate('Media'),
];
$typesWithValues = [];
// Item sets are never surfaced as linked resources (the public site has no
// styled item-set page), so they are never offered as a switchable type either.
// Keep in sync with the resource-type guard in
// view/omeka/site/index/linked-resources.phtml.
foreach (['items', 'media'] as $type) {
    if (!empty($resourcePropertiesAll[$type])) {
        $typesWithValues[] = $type;
    }
}
$baseUrl = $objectResource->url();
$connectionSearch = $connectionSearch ?? '';
$pageUrl = function (int $number) use ($baseUrl, $resourceProperty, $connectionSearch, $fragment) {
    return $baseUrl . '?' . http_build_query(['lr_property' => $resourceProperty, 'lr_q' => $connectionSearch, 'lr_page' => $number]) . '#' . $fragment;
};
?>
<details class="resources-linked" id="<?php echo $fragment; ?>" open>

    <summary class="resources-linked__head">
        <span class="resources-linked__headwrap">
            <h2 class="resources-linked__heading" id="linked-resources-heading"><?php echo $translate('Linked resources'); ?></h2>
            <span class="resources-linked__summary" aria-live="polite">
                <b data-lr-count><?php echo $uniqueCount; ?></b>
                <span data-lr-label
                    data-one="<?php echo $escapeAttr($summaryLabel(1)); ?>"
                    data-many="<?php echo $escapeAttr($summaryLabel(2)); ?>"><?php
                    echo $escape($summaryLabel($uniqueCount)); ?></span>
            </span>
        </span>
        <span class="resources-linked__chevron" aria-hidden="true"></span>
    </summary>

    <div class="resources-linked__panel">

        <form class="resources-linked__types" method="get" action="<?php echo $escapeAttr($baseUrl); ?>#linked-resources" data-connection-form>
            <label for="resource-property-select"><?php echo $translate('Filter all connections by relationship'); ?></label>
            <select name="lr_property" id="resource-property-select">
                <?php
                $knownOptions = [$resourceType . ':'];
                foreach ($resourcePropertiesAll as $options) {
                    foreach ($options as $option) $knownOptions[] = $option['compound_id'];
                }
                if (!in_array($resourceProperty, $knownOptions, true)):
                ?>
                <option value="<?php echo $escapeAttr($resourceProperty); ?>" selected><?php echo $escape($translate('Selected relationship')); ?></option>
                <?php endif; ?>
                <?php foreach ($typesWithValues as $type): ?>
                    <optgroup label="<?php echo $escapeAttr($typeLabels[$type]); ?>">
                        <?php $optionValue = $type . ':'; ?>
                        <option value="<?php echo $escapeAttr($optionValue); ?>"<?php echo $resourceProperty === $optionValue ? ' selected' : ''; ?>><?php echo $translate('All'); ?></option>
                        <?php foreach ($resourcePropertiesAll[$type] as $option): ?>
                        <option value="<?php echo $escapeAttr($option['compound_id']); ?>"<?php echo $resourceProperty === $option['compound_id'] ? ' selected' : ''; ?>><?php echo $escape($option['label_is_translatable'] ? $translate($option['label']) : $option['label']); ?></option>
                        <?php endforeach; ?>
                    </optgroup>
                <?php endforeach; ?>
            </select>
            <label for="linked-resources-query"><?php echo $translate('Search all connections by title'); ?></label>
            <input type="search" id="linked-resources-query" name="lr_q" value="<?php echo $escapeAttr($connectionSearch); ?>" maxlength="200">
            <button type="submit" class="button"><?php echo $translate('Apply'); ?></button>
        </form>

        <?php if ($showControls): ?>
        <div class="resources-linked__controls">
            <?php if ($hasFacets): ?>
            <div class="resources-linked__facets" role="group" aria-label="<?php echo $escapeAttr($translate('Filter this page by relationship')); ?>">
                <button type="button" class="lr-facet is-active" data-lr-facet="all" aria-pressed="true">
                    <span class="lr-facet__label"><?php echo $translate('All'); ?></span>
                    <span class="lr-facet__count"><?php echo $uniqueCount; ?></span>
                </button>
                <?php foreach ($ranked as $facet): ?>
                <button type="button" class="lr-facet" data-lr-facet="<?php echo $escapeAttr($facet['id']); ?>" aria-pressed="false">
                    <span class="lr-facet__label"><?php echo $escape($facet['label']); ?></span>
                    <span class="lr-facet__count"><?php echo (int) $facet['count']; ?></span>
                </button>
                <?php endforeach; ?>
            </div>
            <?php endif; ?>

            <?php if ($showSort): ?>
            <div class="resources-linked__sort">
                <label class="resources-linked__sort-label" for="linked-resources-sort"><?php echo $translate('Sort this page'); ?></label>
                <select id="linked-resources-sort" data-lr-sort>
                    <option value="relationship"><?php echo $translate('Relationship'); ?></option>
                    <option value="title-asc"><?php echo $translate('Title (A–Z)'); ?></option>
                    <option value="title-desc"><?php echo $translate('Title (Z–A)'); ?></option>
                </select>
            </div>
            <?php endif; ?>
        </div>
        <?php endif; ?>

        <ul class="connections" id="linked-resources-list" data-lr-list>
            <?php foreach ($connections as $c): ?>
                <?php
                $resource = $c['resource'];
                $propAttr = implode(' ', $c['relIds']);
                // Item type = the record's resource class label (e.g. Person,
                // Still Image, Bibliographic Resource); empty when unclassed.
                $resourceClass = $resource->resourceClass();
                $typeLabel = $resourceClass ? $translate($resourceClass->label()) : '';
                // Relationship(s), already rank-ordered, joined with a middot.
                $relText = implode(' · ', array_map(function ($rel) {
                    return $rel['label'];
                }, $c['rels']));
                // thumbnail() resolves an item's primary-media thumbnail (or an
                // item set's / media's own) and returns '' when there is none.
                $thumbnail = $this->thumbnail($resource, 'square', ['alt' => '']);
                ?>
                <li class="connection"
                    data-props="<?php echo $escapeAttr($propAttr); ?>"
                    data-rel-order="<?php echo (int) $c['relOrder']; ?>"
                    data-title="<?php echo $escapeAttr(mb_strtolower($c['heading'])); ?>">
                    <a class="connection__card" href="<?php echo $escapeAttr($resource->url()); ?>">
                        <?php if ($thumbnail): ?>
                        <span class="connection__thumb" aria-hidden="true"><?php echo $thumbnail; ?></span>
                        <?php endif; ?>
                        <span class="connection__body">
                            <span class="connection__title"><?php echo $escape($c['heading']); ?></span>
                            <span class="connection__meta">
                                <?php if ($typeLabel): ?>
                                <span class="connection__type"><?php echo $escape($typeLabel); ?></span>
                                <?php endif; ?>
                                <?php if ($relText): ?>
                                <span class="connection__rel"><?php echo $escape($relText); ?></span>
                                <?php endif; ?>
                            </span>
                        </span>
                    </a>
                    <?php echo $this->partial('common/shortlist-button', ['resource' => $resource]); ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <p class="connections__empty" data-lr-empty<?php echo $uniqueCount ? ' hidden' : ''; ?>><?php echo $translate('No connections match this filter.'); ?></p>

        <?php if ($isPaginated): ?>
        <nav class="linked-footer pagination" aria-label="<?php echo $escapeAttr($translate('Connection pages')); ?>">
            <?php if ($page > 1): ?><a data-connection-page href="<?php echo $escapeAttr($pageUrl($page - 1)); ?>"><?php echo $translate('Previous'); ?></a><?php endif; ?>
            <span><?php echo $escape(sprintf($translate('Page %1$s of %2$s'), $page, (int) ceil($totalCount / $perPage))); ?></span>
            <?php if ($page * $perPage < $totalCount): ?><a data-connection-page href="<?php echo $escapeAttr($pageUrl($page + 1)); ?>"><?php echo $translate('Next'); ?></a><?php endif; ?>
        </nav>
        <?php endif; ?>

    </div>

</details>
