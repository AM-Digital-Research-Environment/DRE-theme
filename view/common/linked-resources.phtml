<?php
/**
 * Consolidated, faceted "Linked resources" view.
 *
 * Renders every record that links to the current resource as one scannable
 * list — an editorial "relationship → title" row per connected record — with
 * relationship facet pills to filter and a control to sort. Replaces the old
 * per-property accordion stack.
 *
 * Variables provided by the core LinkedResources view helper:
 *   $subjectValues          array  groups of subject values, one per property
 *   $totalCount             int    total subject values (across all pages)
 *   $page, $perPage         int    pagination
 *   $resourceType           string current type: items | item_sets | media
 *   $resourcePropertiesAll  array  every linking property, grouped by type
 *   $resourceProperty       string active "type:propertyId" filter (if any)
 *   $objectResource                the resource being viewed
 *
 * Facets and sorting are client-side (linked-resources.js) and act on the
 * records loaded into the current page; the list is fully usable without JS.
 */

$escape     = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$translate  = $this->plugin('translate');

// Locale (mirror the rest of the theme).
$valueLang = null;
if ($this->status()->isSiteRequest()) {
    $lang = $this->lang();
    $valueLang = (bool) $this->siteSetting('filter_locale_values') ? [$lang, ''] : null;
}
$headingTerm = $this->siteSetting('browse_heading_property_term');

// Pagination (only used when the linked set spans more than one page).
$fragment = 'linked-resources';
$pagination = $this->pagination(null, $totalCount, $page, $perPage);
$pagination->setFragment($fragment);
$isPaginated = $totalCount > $perPage;

// --- Merge the per-property groups into one list, keyed by connected record.
//     A record linked through several properties (e.g. author *and* editor)
//     appears once, carrying every relationship. Facet counts are per
//     relationship, so they may sum to more than the unique record count. ---
$connections = []; // resourceId => [resource, heading, rels[], relIds[]]
$facets      = []; // list of [id, label, count, groupOrder]
$facetIndex  = []; // propertyId => position in $facets
$groupOrder  = 0;

foreach ($subjectValues as $values) {
    if (!$values) {
        continue;
    }
    $first = $values[0];
    $propertyId = $first['property_id'];
    $propertyLabel = ($first['property_alternate_label'] ?? '') ?: $translate($first['property_label']);

    if (!isset($facetIndex[$propertyId])) {
        $facetIndex[$propertyId] = count($facets);
        $facets[] = [
            'id' => $propertyId,
            'label' => $propertyLabel,
            'count' => 0,
            'groupOrder' => $groupOrder,
        ];
    }
    $fi = $facetIndex[$propertyId];

    foreach ($values as $value) {
        $resource = $value['val']->resource();
        if (!$resource) {
            continue;
        }
        $rid = $resource->id();
        if (!isset($connections[$rid])) {
            $heading = $headingTerm
                ? $resource->value($headingTerm, ['default' => $resource->displayTitle(null, $valueLang), 'lang' => $valueLang])
                : $resource->displayTitle(null, $valueLang);
            $connections[$rid] = [
                'resource' => $resource,
                'heading'  => (string) $heading,
                'rels'     => [],
                'relIds'   => [],
            ];
        }
        if (!in_array($propertyId, $connections[$rid]['relIds'], true)) {
            $connections[$rid]['relIds'][] = $propertyId;
            $connections[$rid]['rels'][]   = ['id' => $propertyId, 'label' => $propertyLabel];
            $facets[$fi]['count']++;
        }
    }
    $groupOrder++;
}

// Rank relationships by frequency (most-connected first), ties by server
// order. Both the facet pills and the "relationship" sort follow this rank.
$ranked = $facets;
usort($ranked, function ($a, $b) {
    return ($b['count'] <=> $a['count']) ?: ($a['groupOrder'] <=> $b['groupOrder']);
});
$rankById = [];
foreach ($ranked as $i => $facet) {
    $rankById[$facet['id']] = $i;
}

// Give each record a sort key (its highest-ranked relationship) and order its
// own relationship chips by rank.
foreach ($connections as &$c) {
    $ranks = array_map(function ($id) use ($rankById) {
        return $rankById[$id];
    }, $c['relIds']);
    $c['relOrder'] = $ranks ? min($ranks) : 0;
    usort($c['rels'], function ($a, $b) use ($rankById) {
        return $rankById[$a['id']] <=> $rankById[$b['id']];
    });
}
unset($c);

// Default render order = the "relationship" sort (rank, then title), so the
// JS sort is a no-op on load and there is no reflow.
uasort($connections, function ($a, $b) {
    return ($a['relOrder'] <=> $b['relOrder']) ?: strcasecmp($a['heading'], $b['heading']);
});

$uniqueCount = count($connections);
$hasFacets   = count($facets) > 1;

// Resource-type switch (only when more than one type links here).
$typeLabels = [
    'items'     => $translate('Items'),
    'item_sets' => $translate('Item sets'),
    'media'     => $translate('Media'),
];
$typesWithValues = [];
foreach (['items', 'item_sets', 'media'] as $type) {
    if (!empty($resourcePropertiesAll[$type])) {
        $typesWithValues[] = $type;
    }
}
$baseUrl = $this->url(null, [], true);
?>
<div class="resources-linked" id="<?php echo $fragment; ?>" role="region" aria-labelledby="linked-resources-heading">

    <div class="resources-linked__bar<?php echo $hasFacets ? '' : ' resources-linked__bar--divided'; ?>">
        <div class="resources-linked__headwrap">
            <h3 class="resources-linked__heading" id="linked-resources-heading"><?php echo $translate('Linked resources'); ?></h3>
            <p class="resources-linked__summary" aria-live="polite">
                <b data-lr-count><?php echo $uniqueCount; ?></b>
                <?php echo $isPaginated ? $translate('connections on this page') : $translate('connections to this record'); ?>
            </p>
        </div>

        <?php if ($uniqueCount > 1): ?>
        <div class="resources-linked__sort">
            <label class="resources-linked__sort-label" for="linked-resources-sort"><?php echo $translate('Sort'); ?></label>
            <select id="linked-resources-sort" data-lr-sort>
                <option value="relationship"><?php echo $translate('Relationship'); ?></option>
                <option value="title-asc"><?php echo $translate('Title (A–Z)'); ?></option>
                <option value="title-desc"><?php echo $translate('Title (Z–A)'); ?></option>
            </select>
        </div>
        <?php endif; ?>
    </div>

    <?php if (count($typesWithValues) > 1): ?>
    <nav class="resources-linked__types" aria-label="<?php echo $escapeAttr($translate('Linked resource type')); ?>">
        <?php foreach ($typesWithValues as $type): ?>
        <a class="lr-type"
           href="<?php echo $escapeAttr($baseUrl . '?resource_property=' . rawurlencode($type . ':') . '#' . $fragment); ?>"
           <?php echo ($type === $resourceType) ? 'aria-current="true"' : ''; ?>>
            <?php echo $escape($typeLabels[$type]); ?>
        </a>
        <?php endforeach; ?>
    </nav>
    <?php endif; ?>

    <?php if ($hasFacets): ?>
    <div class="resources-linked__facets" role="group" aria-label="<?php echo $escapeAttr($translate('Filter connections by relationship')); ?>">
        <button type="button" class="lr-facet is-active" data-lr-facet="all" aria-pressed="true">
            <span class="lr-facet__label"><?php echo $translate('All'); ?></span>
            <span class="lr-facet__count"><?php echo $uniqueCount; ?></span>
        </button>
        <?php foreach ($ranked as $facet): ?>
        <button type="button" class="lr-facet" data-lr-facet="p<?php echo (int) $facet['id']; ?>" aria-pressed="false">
            <span class="lr-facet__label"><?php echo $escape($facet['label']); ?></span>
            <span class="lr-facet__count"><?php echo (int) $facet['count']; ?></span>
        </button>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>

    <ul class="connections" data-lr-list>
        <?php foreach ($connections as $c): ?>
            <?php
            $resource = $c['resource'];
            $propAttr = implode(' ', array_map(function ($id) {
                return 'p' . (int) $id;
            }, $c['relIds']));
            // thumbnail() resolves an item's primary-media thumbnail (or an
            // item set's / media's own) and returns '' when there is none.
            $thumbnail = $this->thumbnail($resource, 'square', ['alt' => '']);
            ?>
            <li class="connection"
                data-props="<?php echo $escapeAttr($propAttr); ?>"
                data-rel-order="<?php echo (int) $c['relOrder']; ?>"
                data-title="<?php echo $escapeAttr(mb_strtolower($c['heading'])); ?>">
                <div class="connection__body">
                    <p class="connection__rel">
                        <?php foreach ($c['rels'] as $rel): ?>
                        <span class="connection__rel-item"><?php echo $escape($rel['label']); ?></span>
                        <?php endforeach; ?>
                    </p>
                    <?php echo $resource->link($c['heading'], null, ['class' => 'connection__title']); ?>
                </div>
                <?php if ($thumbnail): ?>
                <?php echo $resource->linkRaw($thumbnail, null, ['class' => 'connection__thumb', 'tabindex' => '-1', 'aria-hidden' => 'true']); ?>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <p class="connections__empty" data-lr-empty hidden><?php echo $translate('No connections match this filter.'); ?></p>

    <?php echo $isPaginated ? '<div class="linked-footer">' . $pagination . '</div>' : ''; ?>

</div>
