<?php
/**
 * Record apparatus — the citation / identifier / licence rail.
 *
 * A reader arriving at a journal article with a DOI used to find no citation,
 * licence or download affordance anywhere near the top: the DOI was one row of
 * ~25 in a flat metadata dump, indistinguishable from `Format`. The apparatus
 * now sits in a sticky rail beside the record, so it is met without scrolling
 * past it, and the metadata groups below stay about the *content*.
 *
 * Everything here is optional and self-suppressing: with no citation, DOI,
 * licence or identifier the partial renders nothing and item/show.phtml drops
 * the rail, giving the record the full measure.
 *
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 */

$escHtml = $this->plugin('escapeHtml');
$escAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

if (!isset($resource) || !$resource) {
    return;
}

// Values a reader must be able to read. Licence and access rights are linked
// records here — `dcterms:license` points at the CC-BY-NC-SA-4.0 item, not at a
// string — and casting one of those to string yields the *item's URL*, which is
// what the rail used to print. Resolve the way common/resource-values.phtml
// does: a linked value shows its title and links to the record; a URI value
// falls back to the URI itself when it carries no label (otherwise the row
// vanished entirely); a literal shows its text.
//
// All values, not just the first: records legitimately carry two access-rights
// statements, one linked and one spelled out.
$displayValues = function (string $term) use ($resource): array {
    try {
        $values = $resource->value($term, ['all' => true]) ?: [];
    } catch (\Throwable $e) {
        return [];
    }

    $out = [];
    foreach ($values as $value) {
        try {
            $type = (string) $value->type();
            $label = '';
            $href = '';

            if (false !== strpos($type, 'resource') && $value->valueResource()) {
                $label = trim((string) $value->valueResource()->displayTitle());
                $href = (string) $value->valueResource()->url();
            } elseif ('uri' === $type) {
                $href = (string) $value->uri();
                $label = trim((string) $value) ?: $href;
            } else {
                $label = trim((string) $value);
            }

            if ($label !== '') {
                $out[] = ['label' => $label, 'href' => $href];
            }
        } catch (\Throwable $e) {
            // One malformed value must not cost the reader the whole rail.
            continue;
        }
    }

    return $out;
};

$citationValues = $displayValues('dcterms:bibliographicCitation');
$citation = $citationValues ? $citationValues[0]['label'] : '';

// DRE-SEO formats the record as Chicago/APA/MLA and offers BibTeX/RIS/CSL-JSON
// downloads. The module is optional and may lag the theme on a deploy, so this
// is a lookup and not a call: without it the panel falls back to the curated
// citation above, which is exactly what it showed before the module existed.
$cite = null;
try {
    if ($this->getHelperPluginManager()->has('dreCitation')) {
        $cite = $this->dreCitation($resource);
    }
} catch (\Throwable $e) {
    $cite = null;
}
$citeStyles = is_array($cite) && !empty($cite['styles']) ? $cite['styles'] : [];
$citeDefault = $citeStyles[$cite['defaultStyle'] ?? ''] ?? null
    ? $cite['defaultStyle']
    : (string) array_key_first($citeStyles ?: ['' => null]);
$citeDownloads = is_array($cite) && !empty($cite['downloads']) ? $cite['downloads'] : [];

$doiValues = $displayValues('bibo:doi');
$licence = $displayValues('dcterms:license');
$accessRights = $displayValues('dcterms:accessRights');
$dreId = $displayValues('dre:id');

// A bare DOI string is still a resolvable link.
foreach ($doiValues as $i => $doiValue) {
    if ($doiValue['href'] === '' && preg_match('~^10\.\d{4,9}/\S+$~', $doiValue['label'])) {
        $doiValues[$i]['href'] = 'https://doi.org/' . $doiValue['label'];
    }
}

// Absolute: this row is the thing a reader copies into a footnote, and it is
// also the fallback the copy button hands over.
try {
    $permalink = (string) $resource->url(null, true);
} catch (\Throwable $e) {
    $permalink = '';
}

$rows = [];
if ($doiValues) {
    $rows[] = ['label' => $translate('DOI'), 'values' => $doiValues];
}
if ($permalink !== '') {
    $rows[] = ['label' => $translate('Permalink'), 'values' => [['label' => $permalink, 'href' => $permalink]]];
}
if ($licence) {
    $rows[] = ['label' => $translate('Licence'), 'values' => $licence];
}
if ($accessRights) {
    $rows[] = ['label' => $translate('Access rights'), 'values' => $accessRights];
}
if ($dreId) {
    $rows[] = ['label' => $translate('DRE ID'), 'values' => $dreId];
}

if ($citation === '' && !$rows && !$citeStyles) {
    return;
}

// One id per record so a page carrying two apparatus panels keeps its tabs and
// panels unambiguously paired.
$citeId = 'record-cite-' . (int) $resource->id();

// Prefer a real citation; otherwise give the copy button something honest —
// the record's title and its permalink.
$copyText = $citation;
if ($copyText === '') {
    try {
        $copyText = trim($resource->displayTitle() . ($permalink !== '' ? '. ' . $permalink : ''));
    } catch (\Throwable $e) {
        $copyText = $permalink;
    }
}

// A licence entered as prose — "Educational, research, criticism, and review
// purposes only." — is a sentence, not a token, and the right-aligned bold
// treatment that suits a DOI turns it into a ragged bold block. Stack those.
$isLongRow = function (array $row): bool {
    foreach ($row['values'] as $value) {
        if (mb_strlen($value['label']) > 40) {
            return true;
        }
    }

    return count($row['values']) > 1;
};

$this->inlineScript()->appendFile($this->assetUrl('js/record.js'));
?>
<section class="record-apparatus" aria-labelledby="record-apparatus-title">
    <h2 class="record-apparatus__title" id="record-apparatus-title"><?php echo $escHtml($translate('Cite this record')); ?></h2>

    <?php if ($citeStyles): ?>
        <div class="record-apparatus__cite" data-record-citation>
            <?php if (count($citeStyles) > 1): ?>
                <div class="record-apparatus__styles" role="tablist" aria-label="<?php echo $escAttr($translate('Citation style')); ?>">
                    <?php foreach ($citeStyles as $styleId => $style): ?>
                        <?php $isActive = ($styleId === $citeDefault); ?>
                        <button type="button" class="record-apparatus__style" role="tab"
                            id="<?php echo $escAttr($citeId . '-tab-' . $styleId); ?>"
                            aria-controls="<?php echo $escAttr($citeId . '-panel-' . $styleId); ?>"
                            aria-selected="<?php echo $isActive ? 'true' : 'false'; ?>"
                            tabindex="<?php echo $isActive ? '0' : '-1'; ?>"
                            data-citation-style="<?php echo $escAttr($styleId); ?>"><?php echo $escHtml($style['label']); ?></button>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>

            <?php foreach ($citeStyles as $styleId => $style): ?>
                <?php // The module escapes each citation and emits only <em>/<a>. ?>
                <p class="record-apparatus__citation" role="tabpanel"
                    id="<?php echo $escAttr($citeId . '-panel-' . $styleId); ?>"
                    aria-labelledby="<?php echo $escAttr($citeId . '-tab-' . $styleId); ?>"
                    data-citation-panel="<?php echo $escAttr($styleId); ?>"
                    <?php echo $styleId === $citeDefault ? '' : 'hidden'; ?>><?php echo $style['html']; ?></p>
            <?php endforeach; ?>
        </div>
    <?php elseif ($citation !== ''): ?>
        <p class="record-apparatus__citation"><?php echo $escHtml($citation); ?></p>
    <?php endif; ?>

    <?php if ($rows): ?>
        <dl class="record-apparatus__rows">
            <?php foreach ($rows as $row): ?>
                <div class="record-apparatus__row<?php echo $isLongRow($row) ? ' record-apparatus__row--block' : ''; ?>">
                    <dt><?php echo $escHtml($row['label']); ?></dt>
                    <dd>
                        <?php foreach ($row['values'] as $value): ?>
                            <span class="record-apparatus__value"><?php
                                if ($value['href'] !== ''):
                                    ?><a href="<?php echo $escAttr($value['href']); ?>"><?php echo $escHtml($value['label']); ?></a><?php
                                else:
                                    echo $escHtml($value['label']);
                                endif;
                            ?></span>
                        <?php endforeach; ?>
                    </dd>
                </div>
            <?php endforeach; ?>
        </dl>
    <?php endif; ?>

    <?php // Progressive enhancement: record.js reveals this only where the
          // async clipboard API is available, so it is never a dead control. ?>
    <div class="record-apparatus__actions" data-record-copy hidden>
        <button type="button" class="button btn--secondary record-apparatus__copy"
            data-copy-text="<?php echo $escAttr($copyText); ?>"
            data-copied-label="<?php echo $escAttr($translate('Copied')); ?>">
            <?php echo $escHtml($translate('Copy citation')); ?>
        </button>
    </div>

    <?php if ($citeDownloads): ?>
        <div class="record-apparatus__downloads">
            <span class="record-apparatus__downloads-label"><?php echo $escHtml($translate('Download')); ?></span>
            <ul class="record-apparatus__download-list">
                <?php foreach ($citeDownloads as $download): ?>
                    <li>
                        <a href="<?php echo $escAttr($download['url']); ?>" download><?php echo $escHtml($download['label']); ?></a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    <?php endif; ?>
</section>
