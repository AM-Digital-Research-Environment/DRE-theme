<?php
/**
 * Record apparatus — the citation / identifier / licence rail.
 *
 * A reader arriving at a journal article with a DOI used to find no citation,
 * licence or download affordance anywhere near the top: the DOI was one row of
 * ~25 in a flat metadata dump, indistinguishable from `Format`. The apparatus
 * now sits in a sticky rail beside the record, so it is met without scrolling
 * past it, and the metadata groups below stay about the *content*.
 *
 * Everything here is optional and self-suppressing: with no citation, DOI,
 * licence or identifier the partial renders nothing and item/show.phtml drops
 * the rail, giving the record the full measure.
 *
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 */

$escHtml = $this->plugin('escapeHtml');
$escAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

if (!isset($resource) || !$resource) {
    return;
}

$apparatus = $this->RecordApparatus($resource);
if (!$apparatus) return;
extract($apparatus, EXTR_SKIP);

$this->inlineScript()->appendFile($this->assetUrl('js/record.js'));
?>
<section class="record-apparatus" aria-labelledby="<?php echo $escAttr($citeId . '-title'); ?>">
    <h2 class="record-apparatus__title" id="<?php echo $escAttr($citeId . '-title'); ?>"><?php echo $escHtml($panelTitle); ?></h2>

    <?php if ($citeStyles): ?>
        <div class="record-apparatus__cite" data-record-citation>
            <?php if (count($citeStyles) > 1): ?>
                <div class="record-apparatus__styles" role="tablist" aria-label="<?php echo $escAttr($translate('Citation style')); ?>">
                    <?php foreach ($citeStyles as $styleId => $style): ?>
                        <?php $isActive = ($styleId === $citeDefault); ?>
                        <button type="button" class="record-apparatus__style" role="tab"
                            id="<?php echo $escAttr($citeId . '-tab-' . $styleId); ?>"
                            aria-controls="<?php echo $escAttr($citeId . '-panel-' . $styleId); ?>"
                            aria-selected="<?php echo $isActive ? 'true' : 'false'; ?>"
                            tabindex="<?php echo $isActive ? '0' : '-1'; ?>"
                            data-citation-style="<?php echo $escAttr($styleId); ?>"><?php echo $escHtml($style['label']); ?></button>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>

            <?php foreach ($citeStyles as $styleId => $style): ?>
                <?php // The module escapes each citation and emits only <em>/<a>. ?>
                <p class="record-apparatus__citation" <?php echo count($citeStyles) > 1 ? 'role="tabpanel" tabindex="0"' : ''; ?>
                    id="<?php echo $escAttr($citeId . '-panel-' . $styleId); ?>"
                    aria-labelledby="<?php echo $escAttr(count($citeStyles) > 1 ? $citeId . '-tab-' . $styleId : $citeId . '-title'); ?>"
                    data-citation-panel="<?php echo $escAttr($styleId); ?>"
                    <?php echo $styleId === $citeDefault ? '' : 'hidden'; ?>><?php echo $style['html']; ?></p>
            <?php endforeach; ?>
        </div>
    <?php elseif ($citation !== ''): ?>
        <p class="record-apparatus__citation"><?php echo $escHtml($citation); ?></p>
    <?php endif; ?>

    <?php if ($rows): ?>
        <dl class="record-apparatus__rows">
            <?php foreach ($rows as $row): ?>
                <div class="record-apparatus__row<?php echo $isLongRow($row) ? ' record-apparatus__row--block' : ''; ?>">
                    <dt><?php echo $escHtml($row['label']); ?></dt>
                    <dd>
                        <?php foreach ($row['values'] as $value): ?>
                            <span class="record-apparatus__value"><?php
                                if ($value['href'] !== ''):
                                    ?><a href="<?php echo $escAttr($value['href']); ?>"><?php echo $escHtml($value['label']); ?></a><?php
                                else:
                                    echo $escHtml($value['label']);
                                endif;
                            ?></span>
                        <?php endforeach; ?>
                    </dd>
                </div>
            <?php endforeach; ?>
        </dl>
    <?php endif; ?>

    <?php // Progressive enhancement: record.js reveals this only where the
          // async clipboard API is available, so it is never a dead control. ?>
    <div class="record-apparatus__actions" data-record-copy hidden>
        <button type="button" class="button btn--secondary record-apparatus__copy"
            data-copy-text="<?php echo $escAttr($copyText); ?>"
            data-copied-label="<?php echo $escAttr($translate('Copied')); ?>">
            <?php echo $escHtml($copyLabel); ?>
        </button>
    </div>

    <?php if ($citeDownloads): ?>
        <div class="record-apparatus__downloads">
            <span class="record-apparatus__downloads-label"><?php echo $escHtml($translate('Download')); ?></span>
            <ul class="record-apparatus__download-list">
                <?php foreach ($citeDownloads as $download): ?>
                    <li>
                        <a href="<?php echo $escAttr($download['url']); ?>" download><?php echo $escHtml($download['label']); ?></a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    <?php endif; ?>
</section>
