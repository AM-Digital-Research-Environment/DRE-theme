<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$this->inlineScript()->appendFile($this->assetUrl('js/masonry.pkgd.min.js'));
$this->inlineScript()->appendFile($this->assetUrl('js/browse.js'));

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

// See helper/BrowseLayout.php — resolves grid/list, the ?view= override, and
// the body-property settings that used to be duplicated in every browse template.
$layout = $this->BrowseLayout();
$isGrid = $layout['isGrid'];
$bodyTruncate = $layout['truncate'];
$queryUrl = $this->url(
    'site/resource', ['controller' => $this->resourceType, 'action' => 'browse'], ['query' => $this->query], true
);

$showThumbnail = in_array('thumbnail', $this->components);
$showHeading = in_array('resource-heading', $this->components);
$showBody = in_array('resource-body', $this->components);
$headingTerm = $this->siteSetting('browse_heading_property_term');
$bodyTerm = $this->siteSetting('browse_body_property_term');

?>

<div class="preview-block clearfix">

    <?php if ($this->heading) : ?>
        <div class="preview-header">
            <h3><?php echo $this->hyperlink($this->heading, $queryUrl); ?></h3>
        </div>
    <?php endif; ?>

    <?php if ($layout['hasToggle']) : ?>
        <div class="browse-controls">
            <?php echo $this->partial('common/browse-layout-toggle', ['layout' => $layout]); ?>
        </div>
    <?php endif; ?>


    <div class="resources <?php echo ($isGrid) ? 'resource-grid' : 'resource-list'; ?>">
        <div class="grid-sizer"></div>
        <div class="gutter-sizer"></div>
        <?php
        foreach ($this->resources as $resource):
            $heading = $headingTerm ? $resource->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $resource->displayTitle(null, ($valueLang));
            $body = $bodyTerm ? $resource->value($bodyTerm) : $resource->displayDescription(null, ($valueLang));
            $media = ($resource instanceof \Omeka\Api\Representation\ItemRepresentation) ? ($resource->media()[0] ?? null) : null;
            $altText = $media ? ($media->altText() ?: $resource->displayTitle()) : $resource->displayTitle();
            $thumbnail = $this->thumbnail($resource, 'large', ['alt' => $altText]);
            echo $this->partial('common/resource-card', [
                'resource' => $resource,
                'heading' => $heading,
                'body' => $showBody ? $body : null,
                'bodyTruncate' => $bodyTruncate,
                'thumbnail' => $showThumbnail ? $thumbnail : '',
                'isGrid' => $isGrid,
                'showHeading' => $showHeading,
                'showTags' => $showHeading,
                // The block's own resourceType ("items"/"item_sets"/"media") is
                // the plural API name; let the partial derive the class from the
                // resource so it matches every other browse surface.
                'typeClass' => null,
            ]);
        endforeach; ?>
    </div>

    <?php
    if ($this->linkText) :
        echo $this->hyperlink($this->linkText, $queryUrl, ['class' => 'browse-all']);
    endif;
    ?>

</div>
