<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$showLocale = (bool) $this->siteSetting('show_locale_label', true);
?>
<div class="item-with-metadata">
    <?php foreach($attachments as $attachment): ?>
        <?php
            $item = $attachment->item();
            if (empty($item)) continue;

            $primaryMedia = $item->primaryMedia();

            // The block's own h3 heads each item; the values render without the
            // record page's contents nav, h2 sections and copy buttons.
            $options = ['recordChrome' => false];
            if ($this->siteSetting('exclude_resources_not_in_site')) {
                $options['siteId'] = $this->currentSite()->id();
            }

            // Get title and title lang.
            $title = (string) $item->displayTitle();
            $titleLang = '';

            if ($showLocale) {
                $template = $item->resourceTemplate();
                if ($template && $template->titleProperty()) {
                    $titleTerm = $template->titleProperty()->term();
                } else {
                    $titleTerm = 'dcterms:title';
                }
                $titleObj = $item->value($titleTerm);
                $titleLang = $titleObj ? (string) $titleObj->lang() : '';
            }
        ?>

        <div class="item-with-metadata__container">
            <!-- Header -->
            <div class="item-with-metadata__header">
                <?php echo $this->ResourceTags($item); ?>
                <h3 class="item-with-metadata__heading">
                    <?php echo $escape($title); ?>
                    <?php if ($titleLang): ?>
                        <span class="language"><?php echo $escape($titleLang); ?></span>
                    <?php endif; ?>
                </h3>
            </div>

            <!-- Content -->
            <div class="item-with-metadata__content">

                <!-- Thumbnail -->
                <?php if ($primaryMedia): ?>
                    <div class="item-with-metadata__thumbnail <?php echo $this->ImageDecoration('media') ? 'decoration' : ''; ?>">
                        <?php $altText = $primaryMedia->altText() ?: $primaryMedia->displayTitle() ?: ''; ?>
                        <?php echo $this->thumbnail($primaryMedia, 'large', ['class' => 'item-thumbnail', 'alt' => $altText]); ?>
                    </div>
                <?php endif; ?>

                <!-- Metadata -->
                <div class="metadata">
                    <?php echo $item->displayValues($options); ?>
                    <?php if($item->itemSets()): ?>
                        <dl class="item-sets">
                            <div class="property">
                                <dt><?php echo $escape($translate('Item sets')); ?></dt>
                                <?php foreach ($item->itemSets() as $itemSet): ?>
                                <dd class="value"><?php echo $itemSet->link($itemSet->displayTitle()); ?></dd>
                                <?php endforeach; ?>
                            </div>
                        </dl>
                    <?php endif; ?>
                    <?php // The record page's own media list (empty without media). ?>
                    <?php echo $this->partial('common/resource-page-block-layout/media-list', ['resource' => $item]); ?>
                </div>

            </div>
        </div>

    <?php endforeach; ?>
</div>
