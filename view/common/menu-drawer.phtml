<?php
$closeText = $this->translate('Close');
$previousText = $this->translate('All sections');
$escAttr = $this->plugin('escapeHtmlAttr');
$escHtml = $this->plugin('escapeHtml');
?>
<nav id="menu-drawer" class="menu-drawer" aria-label="<?php echo $escAttr($this->translate('Mobile navigation')); ?>" aria-hidden="true" inert style="display: none;">
	<div class="wrap">

		<div class="navigation-controls">
			<?php // A real <button>: this control closes the drawer or steps back a
			      // level, it never navigates. It was an `<a href=".">`, which meant
			      // that without JS it reloaded the site root, and it needed a manual
			      // Enter/Space keydown shim in navigation.js that a button gets free.
			      // navigation.js swaps the label/aria between "Close" and
			      // "All sections" via backerContext(). ?>
			<button type="button"
				id="menu-backer"
				class="menu-backer is-empty"
				aria-hidden="true"
				tabindex="-1"
				title="<?php echo $escAttr($closeText); ?>"
			><?php echo $escHtml($closeText); ?></button>
		</div><!-- .navigation-controls -->

		<div id="menu-clones" class="menu-container">

			<?php
			// menus placed here via Javascript (see: asset/js/navigation.js)
			?>

		</div><!-- .menu-container -->

	</div><!-- .wrap -->
</nav><!-- menu-drawer -->

<script>
	// Consumed by asset/js/navigation.js (backerContext). JSON_HEX_TAG escapes
	// "<" so a translated string can't emit a closing script tag and break out
	// of this block — the same guard the PWA manifest island uses in
	// view/layout/layout.phtml.
	//
	// Never write a literal closing script tag anywhere inside a script element,
	// not even in a comment or a string: the HTML parser scans for that byte
	// sequence without understanding JavaScript, ends the element there, and
	// dumps the remainder onto the page as visible text. Doing exactly that,
	// in a comment warning about it, broke this block in v2.21.0. Escape the
	// slash if it is ever unavoidable.
	const closeText = <?php echo json_encode($closeText, JSON_HEX_TAG | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>;
	const previousText = <?php echo json_encode($previousText, JSON_HEX_TAG | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>;
</script>
