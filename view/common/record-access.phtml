<?php
/**
 * Record access — "Access to this material", the first panel of the rail.
 *
 * Three short rows, read in the order a visitor arriving from a search engine
 * has the questions: is there a copy online, who can I ask, and what if nobody
 * answers. Then one link to report a mistake. The contact is generated from the
 * record's project (helper/RecordAccess.php), never typed per record.
 *
 * On a project page the panel is "Access and contact": whose metadata this is,
 * the project's records (searched on the page itself when DRE Search is there),
 * and the same who-to-ask rows. It replaces the statement that used to sit
 * under the project's title.
 *
 * The error report is a ContactUs form when that module is active — messages are
 * stored in admin and mailed to the DRE — and otherwise a pre-filled email to the
 * DRE mailbox carrying the record id and permalink.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 * @var array $access From RecordAccess, passed by item/show.phtml.
 */
if (empty($access) || !in_array($access['kind'] ?? '', ['record', 'project'], true)) return;
$isProject = $access['kind'] === 'project';

$escHtml = $this->plugin('escapeHtml');
$escAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');
$translatePlural = $this->plugin('translatePlural');

// A person with a staff page gets it after the name: "Vierke, Ulf (staff page)".
// The link text repeats per person, so its accessible name says whose page it is.
$linkList = function (array $links) use ($escHtml, $escAttr, $translate): string {
    $parts = [];
    foreach ($links as $link) {
        $part = $link['href'] !== ''
            ? '<a href="' . $escAttr($link['href']) . '">' . $escHtml($link['label']) . '</a>'
            : $escHtml($link['label']);
        if (!empty($link['staffPage'])) {
            $part .= ' (<a href="' . $escAttr($link['staffPage']) . '" aria-label="'
                . $escAttr(sprintf($translate('Staff page of %s'), $link['label'])) . '">'
                . $escHtml($translate('staff page')) . '</a>)';
        }
        $parts[] = $part;
    }
    return implode('; ', $parts);
};
// An access request to the DRE arrives with the record's id, title and link.
$mailLink = '<a href="' . $escAttr($access['requestMailto']) . '">' . $escHtml($access['email']) . '</a>';
$id = 'record-access-' . (int) $access['id'];

// The report form, when the ContactUs module provides one. Optional and possibly
// misconfigured on a deploy, so a failure falls back to the email link.
$reportForm = '';
if ($this->getHelperPluginManager()->has('contactUs')) {
    try {
        $rendered = $this->contactUs([
            'resource' => $resource,
            'heading' => $translate('Report an error in this record'),
            'as_button' => true,
            'template' => 'common/contact-us-button',
        ]);
        $reportForm = is_string($rendered) ? trim($rendered) : '';
    } catch (\Throwable $e) {
        $this->IntegrationWarning($resource, 'contact form', $e);
        $reportForm = '';
    }
}
?>
<section class="record-access" id="<?php echo $escAttr($id); ?>" aria-labelledby="<?php echo $escAttr($id . '-title'); ?>">
    <h2 class="record-apparatus__title" id="<?php echo $escAttr($id . '-title'); ?>"><?php echo $escHtml($isProject ? $translate('Access and contact') : $translate('Access to this material')); ?></h2>

    <?php if ($isProject && $access['contactSource'] !== 'dre'): ?>
        <p class="record-access__note"><?php echo $escHtml($translate('The project team described its material following the curation guidelines of the Digital Research Environment (DRE) and answers for the descriptions. AMIRA holds the descriptions only, not the material.')); ?></p>
    <?php elseif ($isProject): ?>
        <p class="record-access__note"><?php echo $escHtml($translate('AMIRA holds the descriptions of this collection only, not the material.')); ?></p>
    <?php endif; ?>

    <dl class="record-access__rows">
        <?php if ($isProject): ?>
        <?php if (!empty($access['records'])): ?>
        <div class="record-access__row">
            <dt><?php echo $escHtml($translate('Records')); ?></dt>
            <dd>
                <a class="record-access__item" href="<?php echo $escAttr($access['records']['href']); ?>"><?php echo $escHtml(sprintf(
                    $translatePlural('Search its %s record', 'Search its %s records', $access['records']['count']),
                    number_format($access['records']['count'])
                )); ?></a>
                <?php if (!empty($access['records']['collections'])): ?>
                    <span class="record-access__note"><?php echo $escHtml(sprintf(
                        $translatePlural('The collection %s', 'The collections %s', count($access['records']['collections'])),
                        implode('; ', $access['records']['collections'])
                    )); ?></span>
                <?php endif; ?>
            </dd>
        </div>
        <?php endif; ?>
        <?php else: ?>
        <div class="record-access__row">
            <dt><?php echo $escHtml($translate('Online copy')); ?></dt>
            <dd>
                <?php if ($access['hasMedia']): ?>
                    <span class="record-access__item"><?php echo $escHtml($translate('On this page, possibly in part')); ?></span>
                <?php endif; ?>
                <?php foreach ($access['links'] as $link): ?>
                    <a class="record-access__item" href="<?php echo $escAttr($link['href']); ?>"><?php echo $escHtml($link['label']); ?></a>
                <?php endforeach; ?>
                <?php if ($access['links']): ?>
                    <span class="record-access__note"><?php echo $escHtml($translate('Access there may be restricted.')); ?></span>
                <?php elseif (!$access['hasMedia']): ?>
                    <?php echo $escHtml($translate('None linked to this record.')); ?>
                <?php endif; ?>
            </dd>
        </div>
        <?php endif; ?>

        <div class="record-access__row">
            <dt><?php echo $escHtml($translate('Who to ask')); ?></dt>
            <dd>
                <?php if ($access['contactSource'] === 'team'): ?>
                    <?php if ($access['pis']): ?>
                        <span class="record-access__item"><?php echo $linkList($access['pis']); ?>
                            <span class="record-access__role"><?php echo $escHtml($translatePlural('principal investigator', 'principal investigators', count($access['pis']))); ?></span></span>
                    <?php endif; ?>
                    <?php // The team itself is listed on the project page; a big project would turn the rail into a staff list. ?>
                    <?php if ($isProject): ?>
                        <span class="record-access__item"><?php echo $escHtml($access['pis'] ? $translate('or the project’s researchers, listed on this page') : $translate('The project’s researchers, listed on this page')); ?></span>
                    <?php else: ?>
                    <span class="record-access__item"><?php echo sprintf(
                        $escHtml($access['pis'] ? $translate('or the research team of %s') : $translate('The research team of %s')),
                        $linkList($access['projects'])
                    ); ?></span>
                    <?php endif; ?>
                    <?php if (!empty($access['holders'])): ?>
                        <span class="record-access__note"><?php echo $escHtml(sprintf(
                            $translate('Not %s: it keeps the material but does not handle access requests.'),
                            implode('; ', $access['holders'])
                        )); ?></span>
                    <?php endif; ?>
                <?php elseif ($access['contactSource'] === 'mediator'): ?>
                    <span class="record-access__item"><?php echo $linkList($access['contacts']); ?></span>
                <?php else: ?>
                    <span class="record-access__item"><?php echo sprintf($escHtml($translate('The Digital Research Environment (DRE): %s')), $mailLink); ?></span>
                <?php endif; ?>
            </dd>
        </div>

        <?php if ($access['contactSource'] !== 'dre'): ?>
            <div class="record-access__row">
                <dt><?php echo $escHtml($translate('No reply?')); ?></dt>
                <dd><?php echo sprintf($escHtml($translate('Write to the DRE: %s')), $mailLink); ?></dd>
            </div>
        <?php endif; ?>
    </dl>

    <div class="record-access__footer">
        <?php if ($reportForm !== ''): ?>
            <span class="record-access__note"><?php echo $escHtml($translate('Found a mistake in this record? Tell the DRE.')); ?></span>
            <div class="record-access__report"><?php echo $reportForm; ?></div>
        <?php else: ?>
            <a class="record-access__report-link" href="<?php echo $escAttr($access['reportMailto']); ?>"><?php echo $escHtml($translate('Report an error in this record')); ?></a>
        <?php endif; ?>
        <?php if ($access['accessPageUrl'] !== ''): ?>
            <a href="<?php echo $escAttr($access['accessPageUrl']); ?>"><?php echo $escHtml($translate('More about access')); ?></a>
        <?php endif; ?>
    </div>
</section>
